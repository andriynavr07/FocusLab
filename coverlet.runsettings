<?xml version="1.0" encoding="utf-8"?>
<!-- Налаштування збору покриття (coverlet.collector). Команди запуску — у documents/code-coverage.md -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Тестові збірки не враховуємо у відсотку -->
          <Exclude>[*.Tests]*,[xunit.*]*</Exclude>
          <!-- Згенерований код не вимірюємо -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/**/*.cs,**/obj/**/*.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>true</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
