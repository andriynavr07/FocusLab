<UserControl x:Class="frontend.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             FontFamily="{StaticResource MainFontFamily}"
             FontSize="{StaticResource BodyFontSize}"
             Background="{DynamicResource DarkBackgroundBrush}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>

        <!-- Іконки -->
        <Geometry x:Key="LoginMailIcon">
            M 2,4 L 16,4 L 16,14 L 2,14 Z
            M 2,4 L 9,10 L 16,4
        </Geometry>

        <Geometry x:Key="LoginLockIcon">
            M 4,8 L 14,8 L 14,16 L 4,16 Z
            M 6,8 L 6,5
            A 3,3 0 0 1 12,5
            L 12,8
        </Geometry>

        <Geometry x:Key="LoginEyeOffIcon">
            M 2,2 L 16,16
            M 3,6
            C 1,8 1,9 1,9
            C 4,14 9,16 14,12
            M 7,4
            C 11,3 15,6 17,9
            L 15,12
            M 7,7
            A 3,3 0 0 0 11,11
        </Geometry>

        <Style x:Key="LoginIconStyle" TargetType="Path">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke"
                    Value="{DynamicResource DarkSecondaryTextBrush}"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="LoginLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource ControlTextStyle}">
            <Setter Property="FontWeight"
                    Value="{StaticResource MediumFontWeight}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource WhiteBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Поле електронної пошти з підказкою -->
        <Style x:Key="LoginTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource MainFontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource BodyFontSize}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource WhiteBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource DarkInputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource DarkBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush"
                    Value="{DynamicResource WhiteBrush}"/>
            <Setter Property="SelectionBrush"
                    Value="{DynamicResource PrimaryBrush}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource StandardCornerRadius}">

                            <Grid Margin="{StaticResource LoginInputPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0"
                                      Data="{StaticResource LoginMailIcon}"
                                      Style="{StaticResource LoginIconStyle}"/>

                                <Grid Grid.Column="2">
                                    <ScrollViewer
                                        x:Name="PART_ContentHost"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        x:Name="Placeholder"
                                        Text="{TemplateBinding Tag}"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        FontSize="{TemplateBinding FontSize}"
                                        Foreground="{DynamicResource DarkSecondaryTextBrush}"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder"
                                        Property="Visibility"
                                        Value="Visible"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле пароля -->
        <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource MainFontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource BodyFontSize}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource WhiteBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource DarkInputBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource DarkBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush"
                    Value="{DynamicResource WhiteBrush}"/>
            <Setter Property="SelectionBrush"
                    Value="{DynamicResource PrimaryBrush}"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="PasswordBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource StandardCornerRadius}">

                            <Grid Margin="{StaticResource LoginInputPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>

                                <Path Grid.Column="0"
                                      Data="{StaticResource LoginLockIcon}"
                                      Style="{StaticResource LoginIconStyle}"/>

                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"/>

                                <!-- Візуальний індикатор прихованого пароля -->
                                <Path Grid.Column="3"
                                      HorizontalAlignment="Right"
                                      Data="{StaticResource LoginEyeOffIcon}"
                                      Style="{StaticResource LoginIconStyle}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin"
                                     Value="True">
                                <Setter TargetName="PasswordBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder"
                                        Property="Opacity"
                                        Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Основна кнопка -->
        <Style x:Key="LoginPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource MainFontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource BodyFontSize}"/>
            <Setter Property="FontWeight"
                    Value="{StaticResource SemiBoldFontWeight}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource WhiteBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource StandardCornerRadius}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.9"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Текстові кнопки -->
        <Style x:Key="LoginLinkStyle" TargetType="Button">
            <Setter Property="FontFamily"
                    Value="{StaticResource MainFontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource BodyFontSize}"/>
            <Setter Property="FontWeight"
                    Value="{StaticResource SemiBoldFontWeight}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{DynamicResource TransparentBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Перемикачі теми та мови -->
        <Style x:Key="LoginToggleStyle" TargetType="Button">
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource MainFontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource SmallFontSize}"/>
            <Setter Property="FontWeight"
                    Value="{StaticResource SemiBoldFontWeight}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource WhiteBrush}"/>
            <Setter Property="Background"
                    Value="{DynamicResource DarkToggleBackgroundBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource DarkToggleBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadius6}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1440"
              Height="900"
              Background="{DynamicResource DarkBackgroundBrush}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560"/>
                <ColumnDefinition Width="880"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== ЛІВА ПАНЕЛЬ ==================== -->

            <Border Grid.Column="0"
                    Background="{DynamicResource DarkSurfaceBrush}"
                    BorderBrush="{DynamicResource DarkBorderBrush}"
                    BorderThickness="0,0,1,0">

                <Grid Margin="{StaticResource BrandPanelPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <!-- Логотип і перемикачі -->
                    <Grid Grid.Row="0">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Width="36"
                                    Height="36"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="{StaticResource CornerRadius12}">

                                <Path Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource WhiteBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round"
                                      Data="M 11,1 L 3,10 L 9,10 L 7,17 L 15,7 L 9,7 Z"/>
                            </Border>

                            <TextBlock Text="FocusLab"
                                       Margin="12,0,0,0"
                                       Style="{StaticResource PageTitleTextStyle}"
                                       Foreground="{DynamicResource WhiteBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Button x:Name="ThemeButton"
                                    Width="49"
                                    Content="Light"
                                    ToolTip="Світла тема"
                                    Style="{StaticResource LoginToggleStyle}"/>

                            <Button x:Name="LanguageButton"
                                    Width="37"
                                    Content="EN"
                                    Margin="26,0,0,0"
                                    ToolTip="English"
                                    Style="{StaticResource LoginToggleStyle}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ілюстрація -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center">

                        <Border Height="220"
                                Background="{DynamicResource DarkIllustrationBackgroundBrush}"
                                BorderBrush="{DynamicResource DarkBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadius16}">

                            <Grid>
                                <Ellipse Width="152"
                                         Height="152"
                                         Stroke="{DynamicResource PrimaryBrush}"
                                         StrokeThickness="7"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="25:00"
                                               Style="{StaticResource TimerTextStyle}"
                                               Foreground="{DynamicResource WhiteBrush}"/>

                                    <TextBlock Text="ФОКУСУВАННЯ"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource CaptionSemiBoldTextStyle}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Сплануй свій день"
                                   Margin="0,24,0,0"
                                   Style="{StaticResource HeroTextStyle}"
                                   Foreground="{DynamicResource WhiteBrush}"
                                   TextAlignment="Center"/>

                        <TextBlock Width="307"
                                   Margin="0,12,0,0"
                                   Text="Працюй, розвивайся, контролюй, але не забувай про відпочинок"
                                   Style="{StaticResource BrandDescriptionTextStyle}"
                                   Foreground="{DynamicResource DarkSecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Width="277"
                               HorizontalAlignment="Left"
                               Text="© 2026 FocusLab. Фокусуйся, одна сесія за раз."
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource SlateTextBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- ==================== ФОРМА ВХОДУ ==================== -->

            <Grid Grid.Column="1"
                  Width="440"
                  MinHeight="462"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Border Background="{DynamicResource DarkSurfaceBrush}"
                        BorderBrush="{DynamicResource DarkBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadius16}"/>

                <StackPanel Margin="{StaticResource Padding32}">

                    <TextBlock Text="ВІТАЄМО!"
                               Style="{StaticResource HeroTextStyle}"
                               Foreground="{DynamicResource WhiteBrush}"/>

                    <TextBlock Text="авторизуйтесь для фокусування на роботі"
                               Margin="0,8,0,24"
                               Style="{StaticResource BodyParagraphTextStyle}"
                               Foreground="{DynamicResource DarkSecondaryTextBrush}"/>

                    <!-- Електронна пошта -->
                    <TextBlock Text="Ел. пошта"
                               Style="{StaticResource LoginLabelStyle}"/>

                    <TextBox x:Name="EmailInput"
                             Text="{Binding Email,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Tag="you@example.com"
                             Margin="0,0,0,16"
                             AutomationProperties.Name="Електронна пошта"
                             Style="{StaticResource LoginTextBoxStyle}"/>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль"
                               Style="{StaticResource LoginLabelStyle}"/>

                    <PasswordBox x:Name="PasswordInput"
                                 ToolTip="Введіть пароль"
                                 Margin="0,0,0,16"
                                 AutomationProperties.Name="Пароль"
                                 Style="{StaticResource LoginPasswordStyle}"/>

                    <!-- Параметри входу -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Content="Запамʼятати мене"
                                  IsChecked="{Binding RememberMe, Mode=TwoWay}"
                                  FontFamily="{StaticResource MainFontFamily}"
                                  FontSize="{StaticResource ControlFontSize}"
                                  Foreground="{DynamicResource DarkSecondaryTextBrush}"
                                  VerticalAlignment="Center"
                                  VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Забули пароль?"
                                FontSize="{StaticResource ControlFontSize}"
                                Style="{StaticResource LoginLinkStyle}"/>
                    </Grid>

                    <Button Content="Увійти"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=PasswordInput}"
                            Style="{StaticResource LoginPrimaryButtonStyle}"/>

                    <!-- Перехід до реєстрації -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,24,0,0">

                        <TextBlock Text="Ще не зареєстровані?"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{DynamicResource DarkSecondaryTextBrush}"
                                   VerticalAlignment="Center"/>

                        <Button Content="Створити акаунт"
                                Margin="4,0,0,0"
                                Command="{Binding GoToRegisterCommand}"
                                Style="{StaticResource LoginLinkStyle}"/>
                    </StackPanel>

                </StackPanel>
            </Grid>

        </Grid>
    </Viewbox>
</UserControl>
