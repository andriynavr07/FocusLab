<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ==================== ОСНОВНІ РЕСУРСИ ==================== -->

    <Thickness x:Key="StandardPadding">10,5,10,5</Thickness>
    <Thickness x:Key="PageMargin">24</Thickness>
    <CornerRadius x:Key="StandardCornerRadius">8</CornerRadius>

    <!-- ==================== РІВНОМІРНІ ВІДСТУПИ ==================== -->

    <Thickness x:Key="Padding0">0</Thickness>
    <Thickness x:Key="Padding2">2</Thickness>
    <Thickness x:Key="Padding3">3</Thickness>
    <Thickness x:Key="Padding4">4</Thickness>
    <Thickness x:Key="Padding6">6</Thickness>
    <Thickness x:Key="Padding8">8</Thickness>
    <Thickness x:Key="Padding10">10</Thickness>
    <Thickness x:Key="Padding12">12</Thickness>
    <Thickness x:Key="Padding16">16</Thickness>
    <Thickness x:Key="Padding20">20</Thickness>
    <Thickness x:Key="Padding24">24</Thickness>
    <Thickness x:Key="Padding32">32</Thickness>

    <!-- ==================== НАВІГАЦІЯ ТА ХЕДЕР ==================== -->

    <Thickness x:Key="SidebarPadding">16,24,16,24</Thickness>
    <Thickness x:Key="NavigationItemPadding">16,10,16,10</Thickness>
    <Thickness x:Key="HeaderPadding">24,0,24,0</Thickness>

    <!-- ==================== КНОПКИ ТА ПОЛЯ ==================== -->

    <Thickness x:Key="ControlPadding">12,8,12,8</Thickness>
    <Thickness x:Key="CompactControlPadding">10,6,10,6</Thickness>
    <Thickness x:Key="SmallButtonPadding">12,6,12,6</Thickness>
    <Thickness x:Key="ProfileButtonPadding">16,8,16,8</Thickness>
    <Thickness x:Key="DialogButtonPadding">24,12,24,12</Thickness>

    <Thickness x:Key="FormInputPadding">14,12,14,12</Thickness>
    <Thickness x:Key="LoginInputPadding">16,0,16,0</Thickness>

    <!-- ==================== БЕЙДЖІ ТА ПРІОРИТЕТИ ==================== -->

    <Thickness x:Key="BadgePadding">8,2,8,2</Thickness>
    <Thickness x:Key="PriorityBadgePadding">8,4,8,4</Thickness>
    <Thickness x:Key="CountBadgePadding">6,2,6,2</Thickness>
    <Thickness x:Key="PriorityChipPadding">14,10,14,10</Thickness>

    <!-- ==================== ДОШКА ТА ТАБЛИЦЯ ЗАДАЧ ==================== -->

    <Thickness x:Key="KanbanColumnPadding">4,8,4,8</Thickness>
    <Thickness x:Key="ColumnHeaderPadding">0,0,0,4</Thickness>
    <Thickness x:Key="CardFooterPadding">0,4,0,0</Thickness>

    <Thickness x:Key="TaskRowPadding">12,14,12,14</Thickness>
    <Thickness x:Key="TableFiltersPadding">24,16,24,12</Thickness>
    <Thickness x:Key="TableContainerPadding">24,0,24,24</Thickness>

    <!-- ==================== ПАНЕЛІ ТА ДІАЛОГИ ==================== -->

    <Thickness x:Key="RightPanelPadding">20,24,20,24</Thickness>
    <Thickness x:Key="CalendarTaskPadding">14,12,12,12</Thickness>
    <Thickness x:Key="DialogActionsPadding">0,8,0,0</Thickness>
    <Thickness x:Key="MetadataPadding">8,0,8,0</Thickness>

    <!-- ==================== ТАЙМЕР ==================== -->

    <Thickness x:Key="TimerActionPadding">18,8,18,8</Thickness>
    <Thickness x:Key="TimerStartButtonPadding">32,12,32,12</Thickness>

    <!-- ==================== ЕКРАНИ ВХОДУ ==================== -->

    <Thickness x:Key="BrandPanelPadding">64,48,64,56</Thickness>

    <!-- ==================== ПРОМІЖКИ МІЖ ЕЛЕМЕНТАМИ ==================== -->
    <!-- Числові значення відповідають item spacing у Figma. -->

    <sys:Double x:Key="Spacing0">0</sys:Double>
    <sys:Double x:Key="Spacing1">1</sys:Double>
    <sys:Double x:Key="Spacing2">2</sys:Double>
    <sys:Double x:Key="Spacing3">3</sys:Double>
    <sys:Double x:Key="Spacing4">4</sys:Double>
    <sys:Double x:Key="Spacing6">6</sys:Double>
    <sys:Double x:Key="Spacing8">8</sys:Double>
    <sys:Double x:Key="Spacing10">10</sys:Double>
    <sys:Double x:Key="Spacing12">12</sys:Double>
    <sys:Double x:Key="Spacing16">16</sys:Double>
    <sys:Double x:Key="Spacing20">20</sys:Double>
    <sys:Double x:Key="Spacing24">24</sys:Double>
    <sys:Double x:Key="Spacing28">28</sys:Double>
    <sys:Double x:Key="Spacing32">32</sys:Double>
    <sys:Double x:Key="Spacing40">40</sys:Double>

    <!-- ==================== РАДІУСИ ЗАОКРУГЛЕНЬ ==================== -->

    <CornerRadius x:Key="CornerRadius0">0</CornerRadius>
    <CornerRadius x:Key="CornerRadius2">2</CornerRadius>
    <CornerRadius x:Key="CornerRadius4">4</CornerRadius>
    <CornerRadius x:Key="CornerRadius6">6</CornerRadius>
    <CornerRadius x:Key="CornerRadius8">8</CornerRadius>
    <CornerRadius x:Key="CornerRadius10">10</CornerRadius>
    <CornerRadius x:Key="CornerRadius12">12</CornerRadius>
    <CornerRadius x:Key="CornerRadius14">14</CornerRadius>
    <CornerRadius x:Key="CornerRadius16">16</CornerRadius>
    <CornerRadius x:Key="CornerRadius18">18</CornerRadius>
    <CornerRadius x:Key="CornerRadius20">20</CornerRadius>

</ResourceDictionary>
