<UserControl x:Class="Frontend.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Frontend.Services"
             xmlns:ctl="clr-namespace:Frontend.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Frontend.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1440"
             FontFamily="{StaticResource MainFontFamily}"
             FontSize="{StaticResource BodyFontSize}"
             Background="{DynamicResource FlBg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">


    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="Foreground" Value="{DynamicResource FlText}"/>
        </Style>
    </UserControl.Resources>

    <!-- Масштабування зі збереженням пропорцій макета -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1440"
              Height="900"
              Background="{DynamicResource FlBg}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560"/>
                <ColumnDefinition Width="880"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== ЛІВА ПАНЕЛЬ ==================== -->

            <Border Grid.Column="0"
                    Background="{DynamicResource FlSurface}"
                    BorderBrush="{DynamicResource FlLine}"
                    BorderThickness="0,0,1,0">

                <Grid Margin="{StaticResource BrandPanelPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <!-- Логотип та перемикачі -->
                    <Grid Grid.Row="0">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Width="36"
                                    Height="36"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="{StaticResource CornerRadius12}">

                                <ctl:Icon Kind="ZapOff" Size="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="FocusLab"
                                       Margin="12,0,0,0"
                                       Style="{StaticResource PageTitleTextStyle}"
                                       Foreground="{DynamicResource FlText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Button x:Name="ThemeButton"
                                    Width="49"
                                    Content="{Binding ThemeButtonText}"
                                    ToolTip="{loc:Translate Text=&quot;Світла тема&quot;}"
                                    Style="{StaticResource RegisterToggleStyle}"
                                    Command="{Binding ToggleThemeCommand}"/>

                            <Button x:Name="LanguageButton"
                                    Width="37"
                                    Margin="26,0,0,0"
                                    Content="{Binding LanguageButtonText}"
                                    ToolTip="English"
                                    Style="{StaticResource RegisterToggleStyle}"
                                    Command="{Binding ToggleLanguageCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Таймер і слоган -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center">

                        <Border Height="220"
                                Background="{DynamicResource FlSurface}"
                                BorderBrush="{DynamicResource FlLine}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadius16}">

                            <Grid>
                                <Ellipse Width="152"
                                         Height="152"
                                         Stroke="{DynamicResource PrimaryBrush}"
                                         StrokeThickness="7"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center">

                                    <TextBlock Text="25:00"
                                               Style="{StaticResource TimerTextStyle}"
                                               Foreground="{DynamicResource FlText}"/>

                                    <TextBlock Text="{loc:Translate Text=&quot;ФОКУСУВАННЯ&quot;}"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource CaptionSemiBoldTextStyle}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:Translate Text=&quot;Сплануй свій день&quot;}"
                                   Margin="0,24,0,0"
                                   Style="{StaticResource HeroTextStyle}"
                                   Foreground="{DynamicResource FlText}"
                                   TextAlignment="Center"/>

                        <TextBlock Width="307"
                                   Margin="0,12,0,0"
                                   Text="{loc:Translate Text=&quot;Працюй, розвивайся, контролюй, але не забувай про відпочинок&quot;}"
                                   Style="{StaticResource BrandDescriptionTextStyle}"
                                   Foreground="{DynamicResource FlMuted}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Width="277"
                               HorizontalAlignment="Left"
                               Text="{loc:Translate Text=&quot;© 2026 FocusLab. Фокусуйся, одна сесія за раз.&quot;}"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource FlMuted}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- ==================== ФОРМА РЕЄСТРАЦІЇ ==================== -->

            <Grid Grid.Column="1"
                  Width="440"
                  MinHeight="614"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Border Background="{DynamicResource FlSurface}"
                        BorderBrush="{DynamicResource FlLine}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadius16}"/>

                <StackPanel Margin="{StaticResource Padding32}">

                    <TextBlock Text="{loc:Translate Text=&quot;СТВОРИТИ АКАУНТ&quot;}"
                               Style="{StaticResource HeroTextStyle}"
                               Foreground="{DynamicResource FlText}"/>

                    <TextBlock Margin="0,8,0,24"
                               Text="{loc:Translate Text=&quot;заповніть форму для початку фокусування на роботі&quot;}"
                               Style="{StaticResource BodyParagraphTextStyle}"
                               Foreground="{DynamicResource FlMuted}"/>

                    <!-- Ім'я -->
                    <TextBlock Text="{loc:Translate Text=&quot;Імʼя&quot;}"
                               Style="{StaticResource RegisterFieldLabelStyle}"/>

                    <TextBox x:Name="NameInput" ctl:FieldIcons.Leading="User" Padding="46,0,16,0"
                             Text="{Binding Name,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Tag="{loc:Translate Text=&quot;Ваше імʼя&quot;}"
                             Margin="0,0,0,16"
                             AutomationProperties.Name="Імʼя"
                             Style="{StaticResource RegisterInputStyle}"/>

                    <!-- Електронна пошта -->
                    <TextBlock Text="{loc:Translate Text=&quot;Ел. пошта&quot;}"
                               Style="{StaticResource RegisterFieldLabelStyle}"/>

                    <TextBox x:Name="EmailInput" ctl:FieldIcons.Leading="Mail" Padding="46,0,16,0"
                             Text="{Binding Email,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Tag="you@example.com"
                             Margin="0,0,0,16"
                             AutomationProperties.Name="Електронна пошта"
                             Style="{StaticResource RegisterInputStyle}"/>

                    <!-- Пароль -->
                    <TextBlock Text="{loc:Translate Text=&quot;Пароль&quot;}"
                               Style="{StaticResource RegisterFieldLabelStyle}"/>

                    <PasswordBox x:Name="PasswordInput" ctl:FieldIcons.Leading="LockOpen" ctl:FieldIcons.Trailing="EyeOff" ctl:FieldIcons.TracksPassword="True" Tag="{loc:Translate Text=&quot;введіть пароль&quot;}" Padding="46,0,46,0"
                                 Margin="0,0,0,16"
                                 ToolTip="{loc:Translate Text=&quot;Введіть пароль&quot;}"
                                 AutomationProperties.Name="Пароль"
                                 Style="{StaticResource RegisterPasswordStyle}"/>

                    <!-- Підтвердження пароля -->
                    <TextBlock Text="{loc:Translate Text=&quot;Підтвердження пароля&quot;}"
                               Style="{StaticResource RegisterFieldLabelStyle}"/>

                    <PasswordBox x:Name="ConfirmPasswordInput" ctl:FieldIcons.Leading="LockOpen" ctl:FieldIcons.Trailing="EyeOff" ctl:FieldIcons.TracksPassword="True" Tag="{loc:Translate Text=&quot;повторіть пароль&quot;}" Padding="46,0,46,0"
                                 Margin="0,0,0,16"
                                 ToolTip="{loc:Translate Text=&quot;Повторіть пароль&quot;}"
                                 AutomationProperties.Name="Підтвердження пароля"
                                 Style="{StaticResource RegisterPasswordStyle}"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                    Foreground="#F87171"
                    TextWrapping="Wrap"
                    Margin="0,0,0,12"/>
                    <!-- Збережено твою команду -->
                    <Button Content="{loc:Translate Text=&quot;Зареєструватися&quot;}"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource RegisterButtonStyle}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Center">

                        <TextBlock Text="{loc:Translate Text=&quot;Вже є акаунт?&quot;}"
                                   Foreground="{DynamicResource FlMuted}"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="LoginButton"
                                Content="{loc:Translate Text=&quot;Увійти&quot;}"
                                Margin="4,0,0,0"
                                Command="{Binding NavigateToLoginCommand}"
                                Style="{StaticResource RegisterLinkStyle}"/>
                    </StackPanel>

                </StackPanel>
            </Grid>

        </Grid>
    </Viewbox>
</UserControl>
