<UserControl x:Class="Frontend.Views.TimerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Frontend.ViewModels"
             xmlns:local="clr-namespace:Frontend.Views"
             x:Name="Root">

    <UserControl.Resources>
        <!-- Швидке налаштування -->
        <DataTemplate x:Key="PresetTemplate" DataType="{x:Type vm:PresetOption}">
            <Button Command="{Binding DataContext.SelectPresetCommand, ElementName=Root}"
                    CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,12,0" FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource FlSurface}"
                                BorderBrush="{DynamicResource FlLine}" BorderThickness="1" CornerRadius="12"
                                Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="Nm" Text="{Binding Name}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FlText}"/>
                                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Margin="0,4,0,0"
                                           Foreground="{DynamicResource FlMuted}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlAccent}"/>
                                <Setter TargetName="Nm" Property="Foreground" Value="{DynamicResource FlAccent}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Чіп хронології -->
        <DataTemplate x:Key="TimelineTemplate" DataType="{x:Type vm:TimelineEntry}">
            <Border x:Name="Bd" CornerRadius="8" Padding="10,5" Margin="0,0,8,8" BorderThickness="1"
                    BorderBrush="Transparent" Background="{DynamicResource FlSurface2}">
                <TextBlock x:Name="Tx" Text="{Binding Text}" FontSize="12.5" Foreground="{DynamicResource FlMuted}"/>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlSuccess}"/>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlSuccessSoft}"/>
                    <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource FlSuccess}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Active">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlAccent}"/>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlAccentSoft}"/>
                    <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource FlAccent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource FlBg}"
          TextElement.Foreground="{DynamicResource FlText}"
          TextElement.FontFamily="Segoe UI"
          TextElement.FontSize="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:TopBar Title="ТАЙМЕР" ShowSearch="False" ShowAddButton="False"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Центр -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="540" HorizontalAlignment="Center" Margin="28,44,28,32">

                    <Grid Width="230" Height="230" HorizontalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource FlLine}" StrokeThickness="10"/>
                        <Ellipse Stroke="{DynamicResource FlAccent}" StrokeThickness="10"
                                 RenderTransformOrigin="0.5,0.5"
                                 StrokeDashArray="{Binding Progress, Converter={StaticResource FlProgressToDash}, ConverterParameter='230;10'}">
                            <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimeText}" FontSize="54" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SessionText}" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FlAccent}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button Style="{StaticResource FlIconButton}" Content="&#xE777;" FontSize="16" Padding="13"
                                BorderBrush="{DynamicResource FlLine}" Background="{DynamicResource FlSurface2}"
                                Command="{Binding ResetCommand}" ToolTip="Скинути"/>
                        <Button Style="{StaticResource FlPrimaryButton}" Width="160" Margin="12,0"
                                Padding="14,13" Command="{Binding ToggleCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StartPauseGlyph}" FontFamily="{StaticResource FlIcons}"
                                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StartPauseText}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlIconButton}" Content="&#xE893;" FontSize="16" Padding="13"
                                BorderBrush="{DynamicResource FlLine}" Background="{DynamicResource FlSurface2}"
                                Command="{Binding SkipCommand}" ToolTip="Пропустити"/>
                    </StackPanel>

                    <TextBlock Text="ШВИДКІ НАЛАШТУВАННЯ" FontSize="12.5" FontWeight="Bold"
                               Foreground="{DynamicResource FlMuted}" Margin="0,44,0,12"/>
                    <ItemsControl ItemsSource="{Binding Presets}" ItemTemplate="{StaticResource PresetTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Grid Margin="0,32,0,10">
                        <TextBlock Text="Щоденна ціль фокусу" Foreground="{DynamicResource FlMuted}"/>
                        <TextBlock Text="{Binding GoalText}" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Style="{StaticResource FlProgress}" Minimum="0" Maximum="100"
                                 Value="{Binding GoalPercent, Mode=OneWay}"/>

                    <TextBlock Text="ХРОНОЛОГІЯ СЬОГОДНІШНІХ СЕСІЙ" FontSize="12.5" FontWeight="Bold"
                               Foreground="{DynamicResource FlMuted}" Margin="0,32,0,12"/>
                    <ItemsControl ItemsSource="{Binding Timeline}" ItemTemplate="{StaticResource TimelineTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Параметри -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource FlLine}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,24,24,24">
                        <TextBlock Text="НАЛАШТУВАННЯ ТАЙМЕРА" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource FlMuted}"/>
                        <TextBlock Text="Параметри" FontSize="22" FontWeight="Bold" Margin="0,4,0,22"/>

                        <Grid>
                            <TextBlock Text="Тривалість роботи" Foreground="{DynamicResource FlMuted}"/>
                            <TextBlock Text="{Binding WorkText}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Style="{StaticResource FlSlider}" Minimum="5" Maximum="60" Margin="0,8,0,20"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding WorkMinutes, Mode=TwoWay}"/>

                        <Grid>
                            <TextBlock Text="Коротка перерва" Foreground="{DynamicResource FlMuted}"/>
                            <TextBlock Text="{Binding ShortText}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Style="{StaticResource FlSlider}" Minimum="1" Maximum="15" Margin="0,8,0,20"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding ShortBreakMinutes, Mode=TwoWay}"/>

                        <Grid>
                            <TextBlock Text="Довга перерва" Foreground="{DynamicResource FlMuted}"/>
                            <TextBlock Text="{Binding LongText}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider Style="{StaticResource FlSlider}" Minimum="5" Maximum="30" Margin="0,8,0,22"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding LongBreakMinutes, Mode=TwoWay}"/>

                        <Border BorderBrush="{DynamicResource FlLine}" BorderThickness="0,1,0,1" Padding="0,16"
                                Margin="0,0,0,24">
                            <Grid>
                                <TextBlock Text="Автозапуск наступної сесії" VerticalAlignment="Center"/>
                                <CheckBox Style="{StaticResource FlSwitch}" HorizontalAlignment="Right"
                                          IsChecked="{Binding AutoStart, Mode=TwoWay}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="ФОНОВИЙ ШУМ" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource FlMuted}" Margin="0,0,0,12"/>
                        <ListBox ItemsSource="{Binding NoiseOptions}" SelectedItem="{Binding SelectedNoise, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource FlOptionItem}" Background="Transparent"
                                 BorderThickness="0" Padding="0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>