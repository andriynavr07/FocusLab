<UserControl x:Class="Frontend.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Frontend.ViewModels"
             xmlns:local="clr-namespace:Frontend.Views">

    <UserControl.Resources>
        <!-- Крапка події -->
        <DataTemplate x:Key="DotTemplate">
            <Ellipse x:Name="E" Width="6" Height="6" Margin="2,0" Fill="{DynamicResource FlAccent}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="Success">
                    <Setter TargetName="E" Property="Fill" Value="{DynamicResource FlSuccess}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="Danger">
                    <Setter TargetName="E" Property="Fill" Value="{DynamicResource FlDanger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Клітинка дня -->
        <DataTemplate x:Key="DayTemplate" DataType="{x:Type vm:DayCell}">
            <Button Command="{Binding SelectCommand}" IsEnabled="{Binding HasDate}" Cursor="Hand"
                    FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource FlLine}"
                                BorderThickness="0,0,1,1">
                            <Grid>
                                <Border x:Name="Sel" Visibility="Collapsed" BorderThickness="2"
                                        BorderBrush="{DynamicResource FlAccent}"
                                        Background="{DynamicResource FlAccentSoft}"/>
                                <Grid Margin="10,8">
                                    <TextBlock x:Name="Num" Text="{Binding Number}" FontWeight="Medium"
                                               Foreground="{DynamicResource FlText}" VerticalAlignment="Top"
                                               HorizontalAlignment="Left"/>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="4"
                                            Padding="6,1" Background="{DynamicResource FlAccent}"
                                            Visibility="{Binding IsToday, Converter={StaticResource FlBoolToVis}}">
                                        <TextBlock Text="СЬОГОДНІ" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Dots}" ItemTemplate="{StaticResource DotTemplate}"
                                                  VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                                  Margin="0,0,0,6">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlSurface2}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Sel" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource FlAccent}"/>
                                <Setter TargetName="Num" Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!-- Подія в правій панелі -->
        <DataTemplate x:Key="EventTemplate" DataType="{x:Type vm:CalendarEvent}">
            <StackPanel Margin="0,0,0,4">
                <TextBlock Text="{Binding TimeRange}" FontSize="12.5" Foreground="{DynamicResource FlMuted}"
                           Margin="0,12,0,8"/>
                <Border Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                        BorderThickness="1" CornerRadius="10" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Meta}" FontSize="12.5" Foreground="{DynamicResource FlMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource FlBg}"
          TextElement.Foreground="{DynamicResource FlText}"
          TextElement.FontFamily="Segoe UI"
          TextElement.FontSize="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:TopBar Title="КАЛЕНДАР"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Календар -->
            <Grid Grid.Column="0" Margin="28,24,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MonthTitle}" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource FlIconButton}" Content="&#xE76B;" Margin="18,0,6,0"
                                BorderBrush="{DynamicResource FlLine}" Background="{DynamicResource FlSurface2}"
                                Command="{Binding PrevMonthCommand}"/>
                        <Button Style="{StaticResource FlIconButton}" Content="&#xE76C;"
                                BorderBrush="{DynamicResource FlLine}" Background="{DynamicResource FlSurface2}"
                                Command="{Binding NextMonthCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="ЗАВДАНЬ ЦЬОГО МІСЯЦЯ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FlMuted}"/>
                            <TextBlock Text="{Binding MonthTasksText}" FontSize="17" FontWeight="Bold"/>
                        </StackPanel>
                        <Border Width="1" Background="{DynamicResource FlLine}" Margin="20,0"/>
                        <StackPanel>
                            <TextBlock Text="ВИКОНАНО" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FlMuted}"/>
                            <TextBlock Text="{Binding DonePercentText}" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource FlSuccess}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                        BorderThickness="1" CornerRadius="14" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource FlSurface2}" Height="42">
                            <UniformGrid Columns="7">
                                <TextBlock Text="Пн" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FlMuted}" FontWeight="SemiBold"/>
                                <TextBlock Text="Вт" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FlMuted}" FontWeight="SemiBold"/>
                                <TextBlock Text="Ср" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FlMuted}" FontWeight="SemiBold"/>
                                <TextBlock Text="Чт" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FlMuted}" FontWeight="SemiBold"/>
                                <TextBlock Text="Пт" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FlMuted}" FontWeight="SemiBold"/>
                                <TextBlock Text="Сб" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FlMuted}" FontWeight="SemiBold"/>
                                <TextBlock Text="Нд" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource FlMuted}" FontWeight="SemiBold"/>
                            </UniformGrid>
                        </Border>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- Права панель -->
            <Border Grid.Column="1" BorderBrush="{DynamicResource FlLine}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,24,24,24">
                        <TextBlock Text="СПРАВИ НА ДЕНЬ" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource FlMuted}"/>
                        <TextBlock Text="{Binding SelectedDayTitle}" FontSize="22" FontWeight="Bold" Margin="0,4,0,8"/>

                        <ItemsControl ItemsSource="{Binding SelectedEvents}" ItemTemplate="{StaticResource EventTemplate}"/>
                        <TextBlock Text="Немає завдань на цей день" Foreground="{DynamicResource FlMuted}" Margin="0,12"
                                   Visibility="{Binding HasNoEvents, Converter={StaticResource FlBoolToVis}}"/>

                        <Border Margin="0,24,0,0" Padding="16,14" CornerRadius="12"
                                Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Порада від FocusLab" FontWeight="SemiBold"
                                           Foreground="{DynamicResource FlAccent}"/>
                                <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" FontSize="13"
                                           LineHeight="20" Foreground="{DynamicResource FlMuted}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>