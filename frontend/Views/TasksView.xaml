<UserControl x:Class="Frontend.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Frontend.Services"
             xmlns:vm="clr-namespace:Frontend.ViewModels"
             xmlns:local="clr-namespace:Frontend.Views"
             x:Name="Root">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseAddCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:TaskRow}">
            <Border BorderBrush="{DynamicResource FlLine}" BorderThickness="0,0,0,1" Padding="16,0" Height="56"
                    Background="Transparent">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="{loc:Translate Text=&quot;Редагувати&quot;}" Command="{Binding EditCommand}"/>
                        <MenuItem Header="{loc:Translate Text=&quot;Видалити&quot;}" Command="{Binding DeleteCommand}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid x:Name="G">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Style="{StaticResource FlCheckBox}" IsChecked="{Binding IsDone, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Project}" Foreground="{DynamicResource FlAccent}"
                               VerticalAlignment="Center"/>
                    <Border x:Name="Badge" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                            CornerRadius="6" Padding="9,3" Background="{DynamicResource FlSurface2}">
                        <TextBlock x:Name="BadgeText" Text="{Binding PriorityLabel}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource FlMuted}"/>
                    </Border>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource FlIcons}" FontSize="13"
                                   Foreground="{DynamicResource FlMuted}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DueText}" Foreground="{DynamicResource FlMuted}" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="St" Grid.Column="5" Text="{Binding StatusDisplay}" FontWeight="SemiBold"
                               Foreground="{DynamicResource FlStatusText}" VerticalAlignment="Center"/>
                    <Button Grid.Column="6" Style="{StaticResource FlIconButton}" Content="&#xE74D;"
                            Command="{Binding DeleteCommand}" ToolTip="{loc:Translate Text=&quot;Видалити завдання&quot;}"
                            Foreground="{DynamicResource FlDanger}" Padding="8,6" Margin="4,0,0,0"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding PriorityKey}" Value="Critical">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource FlDangerSoft}"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource FlDanger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PriorityKey}" Value="High">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource FlDangerSoft}"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource FlDanger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PriorityKey}" Value="Medium">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource FlWarnSoft}"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource FlWarn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="Title" Property="TextDecorations" Value="{x:Static TextDecorations.Strikethrough}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource FlBg}"
          TextElement.Foreground="{DynamicResource FlText}"
          TextElement.FontFamily="Segoe UI"
          TextElement.FontSize="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:TopBar Title="{loc:Translate Text=&quot;ЗАВДАННЯ&quot;}"/>

            <Grid Grid.Row="1" Margin="28,28,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Фільтри -->
                <Grid Margin="0,0,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                        <ComboBox Grid.Column="2" Style="{StaticResource FlComboBox}" ItemsSource="{Binding ProjectFilters}"
                                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}"/>
                        <ComboBox Grid.Column="4" Style="{StaticResource FlComboBox}" ItemsSource="{Binding PriorityFilters}"
                                  SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"/>

                        <TextBlock Grid.Column="6" Text="{loc:Translate Text=&quot;Сортувати за:&quot;}" Foreground="{DynamicResource FlMuted}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="8" Style="{StaticResource FlComboBox}" ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSort, Mode=TwoWay}"/>
                    </Grid>
                    <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Скинути фільтри&quot;}"
                                Command="{Binding ResetFiltersCommand}" Padding="12,7" Margin="12,0,0,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Проєкти&quot;}"
                                    Command="{Binding OpenProjectManagerCommand}" Padding="12,7" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Теги&quot;}"
                                    Command="{Binding OpenTagManagerCommand}" Padding="12,7"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Translate Text=&quot;Теги:&quot;}" Foreground="{DynamicResource FlMuted}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ItemsControl ItemsSource="{Binding FilterTagOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Foreground="{DynamicResource FlText}" Margin="0,0,12,0"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>
                </Grid>

                <!-- Таблиця -->
                <Border Grid.Row="1" Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                        BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource FlSurface2}" Height="44" Padding="16,0"
                                CornerRadius="12,12,0,0"
                                BorderBrush="{DynamicResource FlLine}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource FlCheckBox}" VerticalAlignment="Center"
                                          Command="{Binding ToggleAllCommand}"
                                          IsChecked="{Binding AllDone, Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Text="{loc:Translate Text=&quot;НАЗВА ЗАВДАННЯ&quot;}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource FlColumnHeader}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{loc:Translate Text=&quot;ПРОЄКТ&quot;}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource FlColumnHeader}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{loc:Translate Text=&quot;ПРІОРИТЕТ&quot;}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource FlColumnHeader}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{loc:Translate Text=&quot;ТЕРМІН&quot;}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource FlColumnHeader}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{loc:Translate Text=&quot;СТАТУС&quot;}" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource FlColumnHeader}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource RowTemplate}"/>
                                <TextBlock Text="{loc:Translate Text=&quot;Нічого не знайдено&quot;}" Foreground="{DynamicResource FlMuted}"
                                           HorizontalAlignment="Center" Margin="0,40"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource FlBoolToVis}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- МОДАЛКА: нове завдання (макет focuslab-add-task-modal) -->
        <Grid Visibility="{Binding IsAddOpen, Converter={StaticResource FlBoolToVis}}">
            <Border Background="{DynamicResource FlOverlay}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAddCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Width="520" MaxHeight="700" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                    BorderThickness="1" CornerRadius="16" Padding="32">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Заголовок + кнопка закриття -->
                    <Grid>
                        <TextBlock Text="{Binding FormTitle}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource FlIconButton}" Content="&#xE711;"
                                Width="34" Height="34" Padding="0" FontSize="13"
                                Background="{DynamicResource FlSurface2}" BorderBrush="{DynamicResource FlLine}"
                                Command="{Binding CloseAddCommand}"/>
                    </Grid>

                    <!-- Назва -->
                    <TextBlock Text="{loc:Translate Text=&quot;Назва * (1–255)&quot;}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource FlMuted}" Margin="0,22,0,8"/>
                    <TextBox Style="{StaticResource FlTextBox}" Tag="{loc:Translate Text=&quot;Введіть назву завдання...&quot;}" MaxLength="255"
                             Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding TitleValidationMessage}" Foreground="{DynamicResource FlDanger}"
                               Margin="0,6,0,0" TextWrapping="Wrap"/>

                    <!-- Опис -->
                    <TextBlock Text="{loc:Translate Text=&quot;Опис&quot;}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource FlMuted}" Margin="0,18,0,8"/>
                    <TextBox Style="{StaticResource FlTextBox}" Tag="{loc:Translate Text=&quot;Додайте опис (необов'язково)...&quot;}"
                             Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalContentAlignment="Top"/>

                    <!-- Проєкт -->
                    <TextBlock Text="{loc:Translate Text=&quot;Проєкт&quot;}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource FlMuted}" Margin="0,18,0,8"/>
                    <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding ProjectChoices}"
                              SelectedItem="{Binding NewProject, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" Fill="{DynamicResource FlAccent}"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{loc:Translate Text=&quot;Теги&quot;}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource FlMuted}" Margin="0,18,0,8"/>
                    <ItemsControl ItemsSource="{Binding TaskTagOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{Binding Color}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:Translate Text=&quot;Чек-лист&quot;}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource FlMuted}" Margin="0,18,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource FlTextBox}" Tag="{loc:Translate Text=&quot;Нова підзадача&quot;}"
                                 Text="{Binding NewSubtaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="255"/>
                        <Button Grid.Column="2" Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Додати&quot;}"
                                Command="{Binding AddSubtaskCommand}" IsEnabled="{Binding CanAddSubtask}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ChecklistItems}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Style="{StaticResource FlTextBox}"
                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="255" Margin="8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button Style="{StaticResource FlButton}" Content="↑" Padding="6,3"
                                                Command="{Binding DataContext.MoveSubtaskUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource FlButton}" Content="↓" Padding="6,3"
                                                Command="{Binding DataContext.MoveSubtaskDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource FlButton}" Content="×" Padding="6,3"
                                                Command="{Binding DataContext.RemoveSubtaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Пріоритет -->
                    <TextBlock Text="{loc:Translate Text=&quot;Пріоритет&quot;}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource FlMuted}" Margin="0,18,0,8"/>
                    <ListBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding NewPriority, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource FlPriorityItem}"
                             Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,-8,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- Дата виконання + Оцінка часу -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{loc:Translate Text=&quot;Дата виконання&quot;}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource FlMuted}" Margin="0,0,0,8"/>
                            <Grid>
                                <ToggleButton Style="{StaticResource FlFieldToggle}"
                                              IsChecked="{Binding IsDatePickerOpen, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,10,0"
                                                Background="{DynamicResource FlAccent}"/>
                                        <TextBlock Text="{Binding NewDueText}" FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsDatePickerOpen, Mode=TwoWay}" StaysOpen="False"
                                       Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Margin="0,6,0,0" Padding="10" CornerRadius="12"
                                            Background="{DynamicResource FlSurface}"
                                            BorderBrush="{DynamicResource FlLine}" BorderThickness="1">
                                        <StackPanel>
                                            <Calendar SelectedDate="{Binding NewDueDatePick, Mode=TwoWay}"
                                                      DisplayDate="{Binding NewDueDate, Mode=OneWay}"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding Hours}"
                                                          SelectedItem="{Binding NewDueHour, Mode=TwoWay}"
                                                          ItemStringFormat="{}{0:00}"/>
                                                <TextBlock Grid.Column="1" Text=":" FontWeight="Bold" Margin="8,0"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="2" Style="{StaticResource FlComboBox}"
                                                          ItemsSource="{Binding Minutes}"
                                                          SelectedItem="{Binding NewDueMinute, Mode=TwoWay}"
                                                          ItemStringFormat="{}{0:00}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Translate Text=&quot;Оцінка часу&quot;}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource FlMuted}" Margin="0,0,0,8"/>
                            <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding EstimateOptions}"
                                      SelectedItem="{Binding NewEstimate, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Margin="0,0,10,0"
                                                     Fill="{DynamicResource FlAccent}"/>
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Кнопки -->
                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Скасувати&quot;}" Padding="24,12"
                                Background="Transparent" Command="{Binding CloseAddCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource FlPrimaryButton}" Content="{Binding SubmitButtonText}"
                                Padding="32,12" Command="{Binding CreateTaskCommand}"
                                IsEnabled="{Binding CanCreate}"/>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Керування проєктами -->
        <Grid Visibility="{Binding IsProjectManagerOpen, Converter={StaticResource FlBoolToVis}}">
            <Border Background="{DynamicResource FlOverlay}"/>
            <Border Width="680" MaxHeight="620" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                    BorderThickness="1" CornerRadius="16" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Text=&quot;Проєкти&quot;}" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
                        <ListBox ItemsSource="{Binding ProjectRecords}" SelectedItem="{Binding SelectedProjectRecord}"
                                 Background="Transparent" BorderThickness="0" MinHeight="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Новий проєкт&quot;}"
                                Command="{Binding NewProjectCommand}" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Translate Text=&quot;Назва&quot;}" Foreground="{DynamicResource FlMuted}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource FlTextBox}" Text="{Binding CatalogName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{loc:Translate Text=&quot;Колір&quot;}" Foreground="{DynamicResource FlMuted}" Margin="0,16,0,6"/>
                        <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding ColorOptions}"
                                  SelectedItem="{Binding CatalogColor}"/>
                        <TextBlock Text="{Binding CatalogError}" Foreground="{DynamicResource FlDanger}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Видалити&quot;}"
                                    Command="{Binding DeleteProjectCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource FlPrimaryButton}" Content="{loc:Translate Text=&quot;Зберегти&quot;}"
                                    Command="{Binding SaveProjectCommand}"/>
                        </StackPanel>
                        <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Закрити&quot;}"
                                Command="{Binding CloseProjectManagerCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Керування тегами -->
        <Grid Visibility="{Binding IsTagManagerOpen, Converter={StaticResource FlBoolToVis}}">
            <Border Background="{DynamicResource FlOverlay}"/>
            <Border Width="680" MaxHeight="620" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                    BorderThickness="1" CornerRadius="16" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Text=&quot;Теги&quot;}" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
                        <ListBox ItemsSource="{Binding TagRecords}" SelectedItem="{Binding SelectedTagRecord}"
                                 Background="Transparent" BorderThickness="0" MinHeight="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Новий тег&quot;}"
                                Command="{Binding NewTagCommand}" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{loc:Translate Text=&quot;Назва&quot;}" Foreground="{DynamicResource FlMuted}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource FlTextBox}" Text="{Binding CatalogName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="{loc:Translate Text=&quot;Колір&quot;}" Foreground="{DynamicResource FlMuted}" Margin="0,16,0,6"/>
                        <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding ColorOptions}"
                                  SelectedItem="{Binding CatalogColor}"/>
                        <TextBlock Text="{Binding CatalogError}" Foreground="{DynamicResource FlDanger}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Видалити&quot;}"
                                    Command="{Binding DeleteTagCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource FlPrimaryButton}" Content="{loc:Translate Text=&quot;Зберегти&quot;}"
                                    Command="{Binding SaveTagCommand}"/>
                        </StackPanel>
                        <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Закрити&quot;}"
                                Command="{Binding CloseTagManagerCommand}" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>