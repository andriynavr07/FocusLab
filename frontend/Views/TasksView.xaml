<UserControl x:Class="Frontend.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Frontend.ViewModels"
             xmlns:local="clr-namespace:Frontend.Views"
             x:Name="Root">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseAddCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:TaskRow}">
            <Border BorderBrush="{DynamicResource FlLine}" BorderThickness="0,0,0,1" Padding="16,0" Height="56"
                    Background="Transparent">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Видалити" Command="{Binding DeleteCommand}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid x:Name="G">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Style="{StaticResource FlCheckBox}" IsChecked="{Binding IsDone, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                    <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding Title}" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Grid.Column="2" Text="{Binding Project}" Foreground="{DynamicResource FlAccent}"
                               VerticalAlignment="Center"/>
                    <Border x:Name="Badge" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"
                            CornerRadius="6" Padding="9,3" Background="{DynamicResource FlSurface2}">
                        <TextBlock x:Name="BadgeText" Text="{Binding PriorityLabel}" FontSize="11.5" FontWeight="Bold"
                                   Foreground="{DynamicResource FlMuted}"/>
                    </Border>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource FlIcons}" FontSize="13"
                                   Foreground="{DynamicResource FlMuted}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DueText}" Foreground="{DynamicResource FlMuted}" FontSize="13"/>
                    </StackPanel>
                    <TextBlock x:Name="St" Grid.Column="5" Text="{Binding StatusDisplay}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding PriorityKey}" Value="Critical">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource FlDangerSoft}"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource FlDanger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PriorityKey}" Value="High">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource FlDangerSoft}"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource FlDanger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding PriorityKey}" Value="Medium">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource FlWarnSoft}"/>
                    <Setter TargetName="BadgeText" Property="Foreground" Value="{DynamicResource FlWarn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                    <Setter TargetName="St" Property="Foreground" Value="{DynamicResource FlWarn}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="St" Property="Foreground" Value="{DynamicResource FlSuccess}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="G" Property="Opacity" Value="0.55"/>
                    <Setter TargetName="Title" Property="TextDecorations" Value="{x:Static TextDecorations.Strikethrough}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource FlBg}"
          TextElement.Foreground="{DynamicResource FlText}"
          TextElement.FontFamily="Segoe UI"
          TextElement.FontSize="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:TopBar Title="ЗАВДАННЯ"/>

            <Grid Grid.Row="1" Margin="28,28,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Фільтри -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="2" Style="{StaticResource FlComboBox}" ItemsSource="{Binding ProjectFilters}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"/>
                    <ComboBox Grid.Column="4" Style="{StaticResource FlComboBox}" ItemsSource="{Binding PriorityFilters}"
                              SelectedItem="{Binding SelectedPriority, Mode=TwoWay}"/>

                    <TextBlock Grid.Column="6" Text="Сортувати за:" Foreground="{DynamicResource FlMuted}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="8" Style="{StaticResource FlComboBox}" ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}"/>
                </Grid>

                <!-- Таблиця -->
                <Border Grid.Row="1" Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                        BorderThickness="1" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource FlSurface2}" Height="44" Padding="16,0"
                                CornerRadius="12,12,0,0"
                                BorderBrush="{DynamicResource FlLine}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource FlCheckBox}" VerticalAlignment="Center"
                                          Command="{Binding ToggleAllCommand}"
                                          IsChecked="{Binding AllDone, Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Text="НАЗВА ЗАВДАННЯ" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource FlMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="ПРОЄКТ" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource FlMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="ПРІОРИТЕТ" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource FlMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="ТЕРМІН" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource FlMuted}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="СТАТУС" FontWeight="SemiBold" FontSize="12.5"
                                           Foreground="{DynamicResource FlMuted}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding View}" ItemTemplate="{StaticResource RowTemplate}"/>
                                <TextBlock Text="Нічого не знайдено" Foreground="{DynamicResource FlMuted}"
                                           HorizontalAlignment="Center" Margin="0,40"
                                           Visibility="{Binding IsEmpty, Converter={StaticResource FlBoolToVis}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- МОДАЛКА: нове завдання (макет focuslab-add-task-modal) -->
        <Grid Visibility="{Binding IsAddOpen, Converter={StaticResource FlBoolToVis}}">
            <Border Background="{DynamicResource FlOverlay}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAddCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Width="500" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                    BorderThickness="1" CornerRadius="20" Padding="30,28,30,30">
                <StackPanel>
                    <!-- Заголовок + кнопка закриття -->
                    <Grid>
                        <TextBlock Text="Нове завдання" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource FlIconButton}" Content="&#xE711;"
                                Width="34" Height="34" Padding="0" FontSize="13"
                                Background="{DynamicResource FlSurface2}" BorderBrush="{DynamicResource FlLine}"
                                Command="{Binding CloseAddCommand}"/>
                    </Grid>

                    <!-- Назва -->
                    <TextBlock Text="Назва * (1–255)" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource FlMuted}" Margin="0,22,0,8"/>
                    <TextBox Style="{StaticResource FlTextBox}" Tag="Введіть назву завдання..." MaxLength="255"
                             Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- Опис -->
                    <TextBlock Text="Опис" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource FlMuted}" Margin="0,18,0,8"/>
                    <TextBox Style="{StaticResource FlTextBox}" Tag="Додайте опис (необов'язково)..."
                             Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalContentAlignment="Top"/>

                    <!-- Проєкт -->
                    <TextBlock Text="Проєкт" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource FlMuted}" Margin="0,18,0,8"/>
                    <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding ProjectChoices}"
                              SelectedItem="{Binding NewProject, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Margin="0,0,10,0" Fill="{DynamicResource FlAccent}"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Пріоритет -->
                    <TextBlock Text="Пріоритет" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource FlMuted}" Margin="0,18,0,8"/>
                    <ListBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding NewPriority, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource FlPriorityItem}"
                             Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,-8,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- Дата виконання + Оцінка часу -->
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Дата виконання" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource FlMuted}" Margin="0,0,0,8"/>
                            <Grid>
                                <ToggleButton Style="{StaticResource FlFieldToggle}"
                                              IsChecked="{Binding IsDatePickerOpen, Mode=TwoWay}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="3" Margin="0,0,10,0"
                                                Background="{DynamicResource FlAccent}"/>
                                        <TextBlock Text="{Binding NewDueText}" FontWeight="Medium"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </ToggleButton>
                                <Popup IsOpen="{Binding IsDatePickerOpen, Mode=TwoWay}" StaysOpen="False"
                                       Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Margin="0,6,0,0" Padding="10" CornerRadius="12"
                                            Background="{DynamicResource FlSurface}"
                                            BorderBrush="{DynamicResource FlLine}" BorderThickness="1">
                                        <StackPanel>
                                            <Calendar SelectedDate="{Binding NewDueDatePick, Mode=TwoWay}"
                                                      DisplayDate="{Binding NewDueDate, Mode=OneWay}"/>
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding Hours}"
                                                          SelectedItem="{Binding NewDueHour, Mode=TwoWay}"
                                                          ItemStringFormat="{}{0:00}"/>
                                                <TextBlock Grid.Column="1" Text=":" FontWeight="Bold" Margin="8,0"
                                                           VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="2" Style="{StaticResource FlComboBox}"
                                                          ItemsSource="{Binding Minutes}"
                                                          SelectedItem="{Binding NewDueMinute, Mode=TwoWay}"
                                                          ItemStringFormat="{}{0:00}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Оцінка часу" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource FlMuted}" Margin="0,0,0,8"/>
                            <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding EstimateOptions}"
                                      SelectedItem="{Binding NewEstimate, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="12" Height="12" Margin="0,0,10,0"
                                                     Fill="{DynamicResource FlAccent}"/>
                                            <TextBlock Text="{Binding Label}" FontWeight="Medium"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Кнопки -->
                    <Grid Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource FlButton}" Content="Скасувати" Padding="24,12"
                                Background="Transparent" Command="{Binding CloseAddCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource FlPrimaryButton}" Content="Створити завдання"
                                Padding="32,12" Command="{Binding CreateTaskCommand}"
                                IsEnabled="{Binding CanCreate}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>