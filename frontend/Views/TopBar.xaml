<UserControl x:Class="Frontend.Views.TopBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <Border BorderBrush="{DynamicResource FlLine}" BorderThickness="0,0,0,1" Padding="28,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding Title, ElementName=Self}" FontSize="24" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Grid Grid.Column="1" Margin="24,0" MaxWidth="440" HorizontalAlignment="Stretch"
                  Visibility="{Binding ShowSearch, ElementName=Self, Converter={StaticResource FlBoolToVis}}">
                <TextBox Style="{StaticResource FlSearchBox}" Tag="Знайти завдання"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource FlIcons}" FontSize="15"
                           Foreground="{DynamicResource FlMuted}" Margin="15,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            </Grid>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource FlButton}" Content="{Binding ThemeButtonText}"
                        Command="{Binding ToggleThemeCommand}" Padding="12,7" FontSize="13" Margin="0,0,8,0"/>
                <Button Style="{StaticResource FlButton}" Content="{Binding LanguageButtonText}"
                        Command="{Binding ToggleLanguageCommand}" Padding="12,7" FontSize="13" Margin="0,0,14,0"/>

                <Button Style="{StaticResource FlPrimaryButton}" Command="{Binding OpenNewTaskCommand}"
                        Padding="16,9" Margin="0,0,16,0"
                        Visibility="{Binding ShowAddButton, ElementName=Self, Converter={StaticResource FlBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource FlIcons}" Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Додати завдання"/>
                    </StackPanel>
                </Button>

                <Grid Margin="0,0,12,0">
                    <Button Style="{StaticResource FlIconButton}" Content="&#xEA8F;" FontSize="16"
                            Command="{Binding OpenNotificationsCommand}" Padding="11"/>
                    <Popup IsOpen="{Binding IsNotificationsOpen, Mode=TwoWay}" StaysOpen="False"
                           Placement="Bottom" AllowsTransparency="True">
                        <Border Margin="0,6,0,0" Padding="18,14" CornerRadius="12" MinWidth="220"
                                Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                                BorderThickness="1">
                            <TextBlock Text="Немає нових сповіщень" Foreground="{DynamicResource FlMuted}"/>
                        </Border>
                    </Popup>
                </Grid>

                <Border CornerRadius="16" Padding="12,6" Background="{DynamicResource FlSurface}"
                        BorderBrush="{DynamicResource FlLine}" BorderThickness="1" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔥" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StreakText}" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource FlAccentSoft}">
                    <TextBlock Text="{Binding AvatarInitials}" FontWeight="Bold"
                               Foreground="{DynamicResource FlAccent}" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>