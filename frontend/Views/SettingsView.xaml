<UserControl x:Class="Frontend.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Frontend.ViewModels"
             xmlns:local="clr-namespace:Frontend.Views"
             x:Name="Root">

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseModalsCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource FlSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource FlLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="22,18"/>
        </Style>

        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource FlLine}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,12"/>
        </Style>

        <Style x:Key="ValueChip" TargetType="Button" BasedOn="{StaticResource FlButton}">
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ToolTip" Value="Натисніть, щоб змінити"/>
        </Style>

        <!-- Акцентний колір -->
        <DataTemplate x:Key="AccentTemplate" DataType="{x:Type vm:AccentOption}">
            <Button Command="{Binding DataContext.SelectAccentCommand, ElementName=Root}"
                    CommandParameter="{Binding}" Cursor="Hand" Margin="6,0,0,0" ToolTip="{Binding Name}"
                    FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="28" Height="28">
                            <Ellipse Fill="{Binding Brush}"/>
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource FlText}" StrokeThickness="2"
                                     Margin="-3" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource FlBg}"
          TextElement.Foreground="{DynamicResource FlText}"
          TextElement.FontFamily="Segoe UI"
          TextElement.FontSize="14">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:TopBar Title="НАЛАШТУВАННЯ" ShowSearch="False" ShowAddButton="False"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="32,32,32,32">

                    <!-- Профіль -->
                    <Border Style="{StaticResource Card}" Padding="24,22">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="68" Height="68" CornerRadius="34" Background="{DynamicResource FlAccentSoft}">
                                    <TextBlock Text="{Binding Initials}" FontSize="22" FontWeight="Bold"
                                               Foreground="{DynamicResource FlAccent}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UserName}" FontSize="20" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Email}" Foreground="{DynamicResource FlMuted}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource FlButton}" Content="Редагувати профіль" Padding="18,10"
                                    Command="{Binding OpenEditCommand}"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ліва колонка -->
                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Зовнішній вигляд" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="Тема інтерфейсу" Foreground="{DynamicResource FlMuted}"
                                                       VerticalAlignment="Center"/>
                                            <Border HorizontalAlignment="Right" CornerRadius="10" Padding="3"
                                                    Background="{DynamicResource FlSurface2}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource FlSegment}" GroupName="Theme"
                                                                 Content="Темна" IsChecked="{Binding IsDarkTheme, Mode=TwoWay}"/>
                                                    <RadioButton Style="{StaticResource FlSegment}" GroupName="Theme"
                                                                 Content="Світла" IsChecked="{Binding IsLightThemeSelected, Mode=TwoWay}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="0,14,0,0">
                                        <Grid>
                                            <TextBlock Text="Акцентний колір" Foreground="{DynamicResource FlMuted}"
                                                       VerticalAlignment="Center"/>
                                            <ItemsControl HorizontalAlignment="Right" ItemsSource="{Binding Accents}"
                                                          ItemTemplate="{StaticResource AccentTemplate}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Text="Сповіщення" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="Сповіщення про завдання" Foreground="{DynamicResource FlMuted}"/>
                                            <CheckBox Style="{StaticResource FlSwitch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding NotifyTasks, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="Нагадування про перерву" Foreground="{DynamicResource FlMuted}"/>
                                            <CheckBox Style="{StaticResource FlSwitch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding NotifyBreaks, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="Щоденний звіт" Foreground="{DynamicResource FlMuted}"/>
                                            <CheckBox Style="{StaticResource FlSwitch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding DailyReport, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="0,12,0,0">
                                        <Grid>
                                            <TextBlock Text="Звуки сповіщень" Foreground="{DynamicResource FlMuted}"/>
                                            <CheckBox Style="{StaticResource FlSwitch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding Sounds, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Права колонка -->
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Стандартні таймери" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="Робота за замовчуванням" Foreground="{DynamicResource FlMuted}"
                                                       VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource ValueChip}"
                                                    Content="{Binding WorkDefaultText}" Command="{Binding CycleWorkCommand}"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="Перерва за замовчуванням" Foreground="{DynamicResource FlMuted}"
                                                       VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource ValueChip}"
                                                    Content="{Binding BreakDefaultText}" Command="{Binding CycleBreakCommand}"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="0,12,0,0">
                                        <Grid>
                                            <TextBlock Text="Кількість сесій" Foreground="{DynamicResource FlMuted}"
                                                       VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource ValueChip}"
                                                    Content="{Binding SessionsDefaultText}" Command="{Binding CycleSessionsCommand}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Text="Система та приватність" FontWeight="Bold" FontSize="15" Margin="0,0,0,6"/>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="Мова додатку" Foreground="{DynamicResource FlMuted}"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox HorizontalAlignment="Right" Width="150"
                                                      Style="{StaticResource FlComboBox}" ItemsSource="{Binding Languages}"
                                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}">
                                        <Grid>
                                            <TextBlock Text="Керування даними" Foreground="{DynamicResource FlMuted}"
                                                       VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource ValueChip}"
                                                    Content="Експортувати дані" ToolTip="{x:Null}"
                                                    Command="{Binding ExportCommand}"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SettingRow}" BorderThickness="0" Padding="0,12,0,0">
                                        <Grid>
                                            <TextBlock Text="Небезпечна зона" Foreground="{DynamicResource FlMuted}"
                                                       VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource ValueChip}"
                                                    Content="Видалити акаунт" ToolTip="{x:Null}"
                                                    Background="Transparent" BorderBrush="{DynamicResource FlDanger}"
                                                    Foreground="{DynamicResource FlDanger}"
                                                    Command="{Binding OpenDeleteCommand}"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="8,24,8,0">
                        <TextBlock Text="{Binding VersionText}" Foreground="{DynamicResource FlMuted}" FontSize="13"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource FlButton}" Background="Transparent"
                                BorderBrush="Transparent" Foreground="{DynamicResource FlAccent}" Padding="0"
                                Content="Служба підтримки" Command="{Binding OpenSupportCommand}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- МОДАЛКА: редагування профілю -->
        <Grid Visibility="{Binding IsEditOpen, Converter={StaticResource FlBoolToVis}}">
            <Border Background="{DynamicResource FlOverlay}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseModalsCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Width="440" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource Card}" CornerRadius="20" Padding="28,26">
                <StackPanel>
                    <TextBlock Text="Редагувати профіль" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Ім’я" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource FlMuted}"
                               Margin="0,20,0,8"/>
                    <TextBox Style="{StaticResource FlTextBox}" Tag="Ваше ім’я"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Email" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource FlMuted}"
                               Margin="0,16,0,8"/>
                    <TextBox Style="{StaticResource FlTextBox}" Tag="name@example.com"
                             Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"/>
                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource FlButton}" Content="Скасувати" Padding="22,12"
                                Command="{Binding CloseModalsCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource FlPrimaryButton}" Content="Зберегти"
                                Padding="30,12" Command="{Binding SaveProfileCommand}"
                                IsEnabled="{Binding CanSaveProfile}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- МОДАЛКА: видалення акаунта -->
        <Grid Visibility="{Binding IsDeleteOpen, Converter={StaticResource FlBoolToVis}}">
            <Border Background="{DynamicResource FlOverlay}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseModalsCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Width="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource Card}" CornerRadius="20" Padding="28,26">
                <StackPanel>
                    <TextBlock Text="Видалити акаунт?" FontSize="22" FontWeight="Bold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource FlMuted}" Margin="0,12,0,0"
                               Text="Усі ваші завдання, сесії та налаштування буде видалено без можливості відновлення."/>
                    <Grid Margin="0,26,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource FlButton}" Content="Скасувати" Padding="22,12"
                                Command="{Binding CloseModalsCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource FlButton}" Content="Так, видалити"
                                Padding="26,12" Background="{DynamicResource FlDanger}"
                                BorderBrush="{DynamicResource FlDanger}" Foreground="White"
                                Command="{Binding ConfirmDeleteCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>