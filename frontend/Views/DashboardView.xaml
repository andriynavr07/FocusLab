<UserControl x:Class="Frontend.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Frontend.Services"
             xmlns:ctl="clr-namespace:Frontend.Controls"
             FontFamily="{StaticResource MainFontFamily}"
             FontSize="{StaticResource ControlFontSize}"
             Background="{DynamicResource FlBg}">

    <UserControl.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{DynamicResource FlText}"/>
        </Style>

        <Style x:Key="DashboardButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource FlButton}">
            <Setter Property="FontFamily"
                    Value="{StaticResource MainFontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource ControlFontSize}"/>
            <Setter Property="Padding"
                    Value="{StaticResource ControlPadding}"/>
        </Style>

        <Style x:Key="DashboardPanelStyle" TargetType="Border">
            <Setter Property="Background"
                    Value="{DynamicResource FlSurface}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource FlLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"
                    Value="{StaticResource CornerRadius16}"/>
            <Setter Property="Padding"
                    Value="{StaticResource Padding20}"/>
        </Style>

        <!-- Пошук спільного списку задач -->
        <Style x:Key="DashboardSearchStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource FlSearchBox}">
        </Style>

        <!-- Картка задачі -->
        <DataTemplate x:Key="TaskCardTemplate">
            <Border Margin="0,0,0,10"
                    Padding="{StaticResource Padding8}"
                    Background="{DynamicResource FlSurface2}"
                    CornerRadius="{StaticResource CornerRadius10}"
                    BorderThickness="1"
                    Cursor="Hand"
                    PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                    MouseMove="Card_MouseMove"
                    MouseLeftButtonUp="Card_MouseLeftButtonUp">

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush"
                                Value="{DynamicResource FlLine}"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource FlDanger}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <TextBlock Text="{Binding Priority}"
                               FontSize="{StaticResource SmallFontSize}"
                               FontWeight="{StaticResource SemiBoldFontWeight}">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FlWarn}"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="КРИТИЧНИЙ">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource FlDanger}"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="ВИСОКИЙ">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource FlDanger}"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding Priority}"
                                                 Value="НИЗЬКИЙ">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource FlSuccess}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding Title}"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource FlText}">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                   BasedOn="{StaticResource TaskTitleTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}"
                                                 Value="True">
                                        <Setter Property="TextDecorations"
                                                Value="Strikethrough"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding DueDate}"
                               Margin="0,8,0,0"
                               FontSize="{StaticResource SmallFontSize}">

                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource FlMuted}"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource FlStatusText}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsOverdue}"
                                                 Value="True">
                                        <Setter Property="Foreground"
                                                Value="{DynamicResource FlDanger}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="{Binding EstimateText}"
                                   FontSize="{StaticResource TinyFontSize}"
                                   Padding="{StaticResource BadgePadding}"
                                   Background="{DynamicResource FlAccentSoft}"
                                   Foreground="{DynamicResource FlAccent}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EstimateText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock
                            Margin="6,0,0,0"
                            Text="{Binding ResourceCount, StringFormat='Ресурси: {0}'}"
                            FontSize="{StaticResource TinyFontSize}"
                            Foreground="{DynamicResource FlMuted}"
                            VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Колонка дошки -->
        <DataTemplate x:Key="BoardColumnTemplate">
            <Border Margin="4,0" Padding="4,0,4,8"
                    CornerRadius="{StaticResource CornerRadius10}"
                    BorderThickness="1"
                    AllowDrop="True"
                    MinHeight="{Binding ViewportHeight, ElementName=BoardScroll}"
                    DragEnter="Column_DragOver"
                    DragOver="Column_DragOver"
                    DragLeave="Column_DragLeave"
                    Drop="Column_Drop">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource FlAccentSoft}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource FlAccent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource FlText}"
                                   Margin="0,0,6,0"
                                   FontWeight="{StaticResource SemiBoldFontWeight}"
                                   TextWrapping="Wrap"/>

                        <Border Grid.Column="1"
                                Padding="{StaticResource CountBadgePadding}"
                                Background="{DynamicResource FlSurface2}"
                                CornerRadius="{StaticResource CornerRadius10}"
                                VerticalAlignment="Top">

                            <TextBlock Text="{Binding Tasks.Count}"
                                       FontSize="{StaticResource TinyFontSize}"
                                       Foreground="{DynamicResource FlMuted}"/>
                        </Border>
                    </Grid>

                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding Tasks}"
                                  ItemTemplate="{StaticResource TaskCardTemplate}"/>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid TextElement.Foreground="{DynamicResource FlText}">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== ХЕДЕР ==================== -->

        <Border Grid.Row="0"
                Padding="{StaticResource HeaderPadding}"
                BorderBrush="{DynamicResource FlLine}"
                BorderThickness="0,0,0,1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="{loc:Translate Text=&quot;ДОШКА ЗАВДАНЬ&quot;}"
                               Style="{StaticResource PageTitleTextStyle}"
                               Foreground="{DynamicResource FlText}"
                               VerticalAlignment="Center"/>

                    <Grid Width="260" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBox x:Name="SearchInput"
                                 Style="{StaticResource DashboardSearchStyle}"
                                 Tag="{loc:Translate Text=&quot;Знайти завдання&quot;}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <ctl:Icon Kind="Search" Size="16" Foreground="{DynamicResource FlMuted}"
                                  Margin="13,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                  IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Content="{Binding ThemeButtonText}"
                            Margin="0,0,8,0"
                            FontSize="{StaticResource SmallFontSize}"
                            Padding="{StaticResource StandardPadding}"
                            Background="{DynamicResource FlSurface2}"
                            Style="{StaticResource DashboardButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"/>

                    <Button Content="{Binding LanguageButtonText}"
                            Margin="0,0,12,0"
                            FontSize="{StaticResource SmallFontSize}"
                            Padding="{StaticResource StandardPadding}"
                            Background="{DynamicResource FlSurface2}"
                            Style="{StaticResource DashboardButtonStyle}"
                            Command="{Binding ToggleLanguageCommand}"/>

                    <Button Content="{loc:Translate Text=&quot;+ Додати завдання&quot;}"
                            Background="{DynamicResource FlAccent}"
                            Style="{StaticResource DashboardButtonStyle}"
                            Command="{Binding OpenNewTaskCommand}"/>

                    <Grid Margin="12,0,0,0">
                        <Button x:Name="NotificationsButton"
                                ToolTip="{loc:Translate Text=&quot;Сповіщення&quot;}"
                                Style="{StaticResource DashboardButtonStyle}"
                                Command="{Binding OpenNotificationsCommand}">
                            <ctl:Icon Kind="Bell" Size="18"/>
                        </Button>
                        <Popup IsOpen="{Binding IsNotificationsOpen, Mode=TwoWay}" StaysOpen="False"
                               Placement="Bottom" PlacementTarget="{Binding ElementName=NotificationsButton}"
                               AllowsTransparency="True">
                            <Border Margin="0,6,0,0" Padding="18,14" CornerRadius="12" MinWidth="220"
                                    Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                                    BorderThickness="1">
                                <TextBlock Text="{loc:Translate Text=&quot;Немає нових сповіщень&quot;}" Foreground="{DynamicResource FlMuted}"/>
                            </Border>
                        </Popup>
                    </Grid>

                    <Border Margin="12,0,0,0"
                            Padding="{StaticResource CompactControlPadding}"
                            Background="{DynamicResource FlSurface2}"
                            CornerRadius="{StaticResource CornerRadius18}">

                        <TextBlock Text="{Binding StreakText}"
                                   FontSize="{StaticResource SmallFontSize}"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <Border Width="32"
                            Height="32"
                            Margin="12,0,0,0"
                            Background="{DynamicResource FlSurface2}"
                            CornerRadius="{StaticResource CornerRadius16}">
                        <TextBlock Text="{Binding AvatarInitials}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ОСНОВНИЙ ВМІСТ ==================== -->

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Канбан -->
            <Grid Grid.Column="0"
                  Margin="{StaticResource PageMargin}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Translate Text=&quot;Канбан завдань&quot;}"
                                   FontSize="{StaticResource BoardSectionFontSize}"
                                   FontWeight="{StaticResource SemiBoldFontWeight}"
                                   VerticalAlignment="Center"/>

                        <Border Margin="8,0,0,0"
                                Padding="{StaticResource BadgePadding}"
                                Background="{DynamicResource FlSurface2}"
                                CornerRadius="{StaticResource CornerRadius10}"
                                VerticalAlignment="Center">

                            <TextBlock
                                Text="{Binding TotalTaskCount, StringFormat='{}{0} завдань'}"
                                FontSize="{StaticResource TinyFontSize}"
                                Foreground="{DynamicResource FlMuted}"/>
                        </Border>
                    </StackPanel>

                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,12,0,12" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource FlComboBox}" Width="150"
                              ItemsSource="{Binding PriorityFilters}"
                              SelectedItem="{Binding SelectedPriorityFilter, Mode=TwoWay}" Margin="0,0,12,6"/>
                    <TextBlock Text="{loc:Translate Text=&quot;Теги:&quot;}" Foreground="{DynamicResource FlMuted}"
                               VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ItemsControl ItemsSource="{Binding TagFilters}" Margin="0,0,8,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Foreground="{DynamicResource FlText}" Margin="0,0,10,0"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Скинути фільтри&quot;}"
                            Command="{Binding ResetBoardFiltersCommand}" Padding="10,6" Margin="0,0,0,6"/>
                </WrapPanel>

                <ScrollViewer x:Name="BoardScroll"
                              Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding Columns}"
                                  ItemTemplate="{StaticResource BoardColumnTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Права панель -->
            <Border Grid.Column="1"
                    Padding="{StaticResource RightPanelPadding}"
                    BorderBrush="{DynamicResource FlLine}"
                    BorderThickness="1,0,0,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Таймер -->
                        <Border Style="{StaticResource DashboardPanelStyle}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{loc:Translate Text=&quot;ЧАС&quot;}"
                                               FontSize="{StaticResource SmallFontSize}"
                                               FontWeight="{StaticResource SemiBoldFontWeight}"/>

                                    <TextBlock Text="{loc:Translate Text=&quot;СФОКУСУВАННЯ&quot;}"
                                               HorizontalAlignment="Right"
                                               FontSize="{StaticResource TinyFontSize}"
                                               Foreground="{DynamicResource FlAccent}"/>
                                </Grid>

                                <Grid Height="180" Margin="0,12,0,12">
                                    <Ellipse Width="160"
                                             Height="160"
                                             Stroke="{DynamicResource FlLine}"
                                             StrokeThickness="8"/>

                                    <Ellipse Width="160"
                                             Height="160"
                                             Stroke="{DynamicResource FlAccent}"
                                             StrokeThickness="5"/>

                                    <TextBlock Text="{Binding Timer.TimeText}"
                                               Style="{StaticResource LargeTimerTextStyle}"
                                               Foreground="{DynamicResource FlText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Button Content="↻"
                                            Margin="0,0,8,0"
                                            ToolTip="{loc:Translate Text=&quot;Скинути&quot;}"
                                            Style="{StaticResource DashboardButtonStyle}"
                                            Command="{Binding ResetTimerCommand}"/>

                                    <Button Content="{Binding Timer.StartPauseText}"
                                            Background="{DynamicResource FlAccent}"
                                            Style="{StaticResource DashboardButtonStyle}"
                                            Command="{Binding ToggleTimerCommand}"/>

                                    <Button Content="■"
                                            Margin="8,0,0,0"
                                            ToolTip="{loc:Translate Text=&quot;Зупинити&quot;}"
                                            Style="{StaticResource DashboardButtonStyle}"
                                            Command="{Binding PauseTimerCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Статус -->
                        <TextBlock Text="{loc:Translate Text=&quot;СТАТУС&quot;}"
                                   Margin="0,28,0,12"
                                   FontSize="{StaticResource SmallFontSize}"
                                   Foreground="{DynamicResource FlMuted}"/>

                        <ItemsControl ItemsSource="{Binding Statistics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="{StaticResource Padding12}"
                                            Background="{DynamicResource FlSurface2}"
                                            CornerRadius="{StaticResource CornerRadius8}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Value}"
                                                       FontWeight="{StaticResource SemiBoldFontWeight}"/>

                                            <TextBlock Text="{Binding Label}"
                                                       Foreground="{DynamicResource FlMuted}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Розклад -->
                        <Grid Margin="0,18,0,12">
                            <TextBlock Text="{loc:Translate Text=&quot;РОЗКЛАД НА ДЕНЬ&quot;}"
                                       FontSize="{StaticResource SmallFontSize}"
                                       Foreground="{DynamicResource FlMuted}"/>

                            <TextBlock Text="{Binding ScheduleDateText}"
                                       HorizontalAlignment="Right"
                                       FontSize="{StaticResource SmallFontSize}"
                                       Foreground="{DynamicResource FlAccent}"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Schedule}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding Time}"
                                                   FontSize="{StaticResource SmallFontSize}"
                                                   Foreground="{DynamicResource FlMuted}"
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Padding="{StaticResource Padding8}"
                                                Background="{DynamicResource FlSurface2}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CornerRadius8}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource FlAccent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource FlText}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                    <Setter Property="Foreground" Value="{DynamicResource FlMuted}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBlock Text="{Binding Duration}"
                                                           Margin="0,3,0,0"
                                                           FontSize="{StaticResource SmallFontSize}"
                                                           Foreground="{DynamicResource FlMuted}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{loc:Translate Text=&quot;На сьогодні немає запланованих завдань і фокус-сесій&quot;}"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource SmallFontSize}"
                                   Foreground="{DynamicResource FlMuted}"
                                   Visibility="{Binding IsScheduleEmpty, Converter={StaticResource FlBoolToVis}}"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="10"
              Visibility="{Binding IsDetailsOpen, Converter={StaticResource FlBoolToVis}}">
            <Border Background="{DynamicResource FlOverlay}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDetailsCommand}"/>
                </Border.InputBindings>
            </Border>
            <Border Width="656" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                    BorderThickness="1" CornerRadius="16" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <DataTemplate x:Key="FileRowTemplate">
                        <Border Margin="0,0,0,10" Padding="12" CornerRadius="10"
                                Background="{DynamicResource FlSurface2}" BorderBrush="{DynamicResource FlLine}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="8" Background="{Binding BadgeBrush}">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{DynamicResource FlMuted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource FlIconButton}" Padding="6" Margin="0,0,8,0"
                                            ToolTip="{loc:Translate Text=&quot;Відкрити&quot;}"
                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <ctl:Icon Kind="Ellipsis" Size="16"/>
                                    </Button>
                                    <Button Style="{StaticResource FlDangerButton}" Width="30" Height="30" Padding="0"
                                            ToolTip="{loc:Translate Text=&quot;Видалити&quot;}"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <ctl:Icon Kind="Trash" Size="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate x:Key="LinkRowTemplate">
                        <Border Margin="0,0,0,10" Padding="12" CornerRadius="10"
                                Background="{DynamicResource FlSurface2}" BorderBrush="{DynamicResource FlLine}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource FlAccentSoft}">
                                    <ctl:Icon Kind="Link" Size="20" Foreground="{DynamicResource FlAccent}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Domain}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource FlAccent}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{DynamicResource FlMuted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource FlIconButton}" Padding="6" Margin="0,0,8,0"
                                            ToolTip="{loc:Translate Text=&quot;Відкрити&quot;}"
                                            Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <ctl:Icon Kind="ArrowUpRight" Size="14"/>
                                    </Button>
                                    <Button Style="{StaticResource FlDangerButton}" Width="30" Height="30" Padding="0"
                                            ToolTip="{loc:Translate Text=&quot;Видалити&quot;}"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <ctl:Icon Kind="Trash" Size="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ScrollViewer.Resources>
                <StackPanel Margin="24">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ctl:Icon Kind="ChevronLeft" Size="12" Foreground="{DynamicResource FlAccent}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SelectedTask.Priority}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FlAccent}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource FlIconButton}" Command="{Binding CloseDetailsCommand}">
                            <ctl:Icon Kind="XCircle" Size="18"/>
                        </Button>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedTask.Title}" FontSize="22" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <Border Grid.Column="1" Margin="16,4,0,0" Padding="8,4" CornerRadius="6" VerticalAlignment="Top"
                                Background="{DynamicResource FlWarnSoft}">
                            <TextBlock Text="{Binding SelectedTask.PriorityLabel}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FlWarn}"/>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedTask.PriorityKey}" Value="Critical">
                                            <Setter Property="Background" Value="{DynamicResource FlDangerSoft}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTask.PriorityKey}" Value="High">
                                            <Setter Property="Background" Value="{DynamicResource FlDangerSoft}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SelectedTask.PriorityKey}" Value="Low">
                                            <Setter Property="Background" Value="{DynamicResource FlSuccessSoft}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding SelectedTask.Description}"
                               Foreground="{DynamicResource FlMuted}" TextWrapping="Wrap" Margin="0,14,0,14" LineHeight="22">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedTask.Description}" Value="">
                                        <Setter Property="Text" Value="Опис не додано"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ctl:Icon Kind="Calendar" Size="14" Foreground="{DynamicResource FlMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding SelectedTask.DueText}" FontSize="12"
                                   Foreground="{DynamicResource FlMuted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource FlLine}" Margin="-24,0,-24,0"/>

                    <Grid Margin="0,22,0,12">
                        <TextBlock Text="{loc:Translate Text=&quot;ФАЙЛИ ТА ПАПКИ&quot;}" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource FlMuted}"/>
                        <TextBlock Text="{Binding FilesCountText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FlMuted}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileRowTemplate}"/>

                    <StackPanel Visibility="{Binding HasLinks, Converter={StaticResource FlBoolToVis}}">
                        <Grid Margin="0,12,0,12">
                            <TextBlock Text="{loc:Translate Text=&quot;ЗАКРІПЛЕНІ ПОСИЛАННЯ&quot;}" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource FlMuted}"/>
                            <TextBlock Text="{Binding LinksCountText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FlMuted}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Links}" ItemTemplate="{StaticResource LinkRowTemplate}"/>
                    </StackPanel>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource FlDashedButton}" Padding="14,14" Command="{Binding AttachFileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ctl:Icon Kind="PlusCircle" Size="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Translate Text=&quot;Прикріпити файл&quot;}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource FlDashedButton}" Padding="14,14" Command="{Binding AttachFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <ctl:Icon Kind="PlusCircle" Size="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Translate Text=&quot;Прикріпити папку&quot;}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource FlLine}" Margin="-24,22,-24,0"/>
                    <TextBlock Text="{Binding SelectedTask.EstimateText, StringFormat='Оцінка часу: {0}'}" Margin="0,14,0,0" Foreground="{DynamicResource FlMuted}"/>
                    <TextBlock Text="{loc:Translate Text=&quot;Статус&quot;}" Foreground="{DynamicResource FlMuted}" Margin="0,16,0,6"/>
                    <ComboBox Style="{StaticResource FlComboBox}" ItemsSource="{Binding TaskStatuses}"
                              SelectedItem="{Binding SelectedTask.Status, Mode=TwoWay}"/>
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Видалити&quot;}" Padding="16,10"
                                Command="{Binding DeleteTaskCommand}"/>
                        <Button Grid.Column="2" Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Редагувати&quot;}"
                                Padding="16,10" Command="{Binding EditTaskCommand}"/>
                        <Button Grid.Column="4" Style="{StaticResource FlButton}" Content="{loc:Translate Text=&quot;Перемкнути виконання&quot;}"
                                Padding="16,10" Command="{Binding ToggleTaskCompleteCommand}"/>
                        <Button Grid.Column="6" Style="{StaticResource FlPrimaryButton}" Content="{loc:Translate Text=&quot;Фокус 25 хв&quot;}"
                                Padding="16,10" Command="{Binding StartTaskFocusCommand}"/>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
