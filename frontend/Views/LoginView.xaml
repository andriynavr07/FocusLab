<UserControl x:Class="Frontend.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="900"
             d:DesignWidth="1440"
             FontFamily="{StaticResource MainFontFamily}"
             FontSize="{StaticResource BodyFontSize}"
             Background="{DynamicResource FlBg}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <Viewbox Stretch="Uniform">
        <Grid Width="1440"
              Height="900"
              Background="{DynamicResource FlBg}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="560"/>
                <ColumnDefinition Width="880"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== ЛІВА ПАНЕЛЬ ==================== -->

            <Border Grid.Column="0"
                    Background="{DynamicResource FlSurface}"
                    BorderBrush="{DynamicResource FlLine}"
                    BorderThickness="0,0,1,0">

                <Grid Margin="{StaticResource BrandPanelPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="30"/>
                    </Grid.RowDefinitions>

                    <!-- Логотип і перемикачі -->
                    <Grid Grid.Row="0">

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Width="36"
                                    Height="36"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="{StaticResource CornerRadius12}">

                                <Path Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource WhiteBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round"
                                      Data="M 11,1 L 3,10 L 9,10 L 7,17 L 15,7 L 9,7 Z"/>
                            </Border>

                            <TextBlock Text="FocusLab"
                                       Margin="12,0,0,0"
                                       Style="{StaticResource PageTitleTextStyle}"
                                       Foreground="{DynamicResource FlText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">

                            <Button Width="49"
                                    Content="{Binding ThemeButtonText}"
                                    ToolTip="Світла тема"
                                    Style="{StaticResource RegisterToggleStyle}"
                                    Command="{Binding ToggleThemeCommand}"/>

                            <Button Width="37"
                                    Content="{Binding LanguageButtonText}"
                                    Margin="26,0,0,0"
                                    ToolTip="English"
                                    Style="{StaticResource RegisterToggleStyle}"
                                    Command="{Binding ToggleLanguageCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Таймер і слоган -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center">

                        <Border Height="220"
                                Background="{DynamicResource FlSurface2}"
                                BorderBrush="{DynamicResource FlLine}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerRadius16}">

                            <Grid>
                                <Ellipse Width="152"
                                         Height="152"
                                         Stroke="{DynamicResource PrimaryBrush}"
                                         StrokeThickness="7"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>

                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="25:00"
                                               Style="{StaticResource TimerTextStyle}"
                                               Foreground="{DynamicResource FlText}"/>

                                    <TextBlock Text="ФОКУСУВАННЯ"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource CaptionSemiBoldTextStyle}"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Сплануй свій день"
                                   Margin="0,24,0,0"
                                   Style="{StaticResource HeroTextStyle}"
                                   Foreground="{DynamicResource FlText}"
                                   TextAlignment="Center"/>

                        <TextBlock Width="307"
                                   Margin="0,12,0,0"
                                   Text="Працюй, розвивайся, контролюй, але не забувай про відпочинок"
                                   Style="{StaticResource BrandDescriptionTextStyle}"
                                   Foreground="{DynamicResource FlMuted}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Width="277"
                               HorizontalAlignment="Left"
                               Text="© 2026 FocusLab. Фокусуйся, одна сесія за раз."
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{DynamicResource FlMuted}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- ==================== КАРТКА ВХОДУ ==================== -->

            <Grid Grid.Column="1"
                  Width="440"
                  MinHeight="462"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center">

                <Border Background="{DynamicResource FlSurface}"
                        BorderBrush="{DynamicResource FlLine}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadius16}"/>

                <StackPanel Margin="{StaticResource Padding32}">

                    <TextBlock Text="ВІТАЄМО!"
                               Style="{StaticResource HeroTextStyle}"
                               Foreground="{DynamicResource FlText}"/>

                    <TextBlock Text="авторизуйтесь для фокусування на роботі"
                               Margin="0,8,0,24"
                               Style="{StaticResource BodyParagraphTextStyle}"
                               Foreground="{DynamicResource FlMuted}"/>

                    <!-- Електронна пошта -->
                    <TextBlock Text="Ел. пошта"
                               Style="{StaticResource RegisterFieldLabelStyle}"/>

                    <TextBox x:Name="EmailInput"
                             Text="{Binding Email,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Tag="you@example.com"
                             Margin="0,0,0,16"
                             AutomationProperties.Name="Електронна пошта"
                             Style="{StaticResource RegisterInputStyle}"/>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль"
                               Style="{StaticResource RegisterFieldLabelStyle}"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Margin="0,0,0,16"
                                 ToolTip="Введіть пароль"
                                 AutomationProperties.Name="Пароль"
                                 Style="{StaticResource RegisterPasswordStyle}"/>

                    <!-- Додаткові параметри -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Content="Запамʼятати мене"
                                  IsChecked="{Binding RememberMe, Mode=TwoWay}"
                                  FontFamily="{StaticResource MainFontFamily}"
                                  FontSize="{StaticResource ControlFontSize}"
                                  Foreground="{DynamicResource FlMuted}"
                                  VerticalContentAlignment="Center"
                                  VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                Content="Забули пароль?"
                                FontSize="{StaticResource ControlFontSize}"
                                Style="{StaticResource RegisterLinkStyle}"
                                Command="{Binding ForgotPasswordCommand}"/>
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#F87171"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- Авторизація -->
                    <Button Content="Увійти"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource RegisterButtonStyle}"/>

                    <!-- Перехід до реєстрації -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Ще не зареєстровані?"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{DynamicResource FlMuted}"
                                   VerticalAlignment="Center"/>

                        <Button Content="Створити акаунт"
                                Margin="4,0,0,0"
                                Command="{Binding NavigateToRegisterCommand}"
                                Style="{StaticResource RegisterLinkStyle}"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>
