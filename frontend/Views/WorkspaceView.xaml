<UserControl x:Class="Frontend.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             FontFamily="{StaticResource MainFontFamily}"
             Background="{DynamicResource FlBg}"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding"
                    Value="{StaticResource NavigationItemPadding}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource FlMuted}"/>
            <Setter Property="Background"
                    Value="{DynamicResource TransparentBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource MainFontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource BodyFontSize}"/>
            <Setter Property="FontWeight"
                    Value="{StaticResource MediumFontWeight}"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource CornerRadius8}">

                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryTintBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="{StaticResource SemiBoldFontWeight}"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource FlSurface2}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Іконки Windows, а не основний текстовий шрифт -->
        <Style x:Key="SidebarIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1440"
              Height="900"
              Background="{DynamicResource FlBg}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Постійна бічна панель -->
            <Border Grid.Column="0"
                    Background="{DynamicResource FlBg}"
                    BorderBrush="{DynamicResource FlLine}"
                    BorderThickness="0,0,1,0">

                <Grid Margin="{StaticResource SidebarPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="32"
                                Height="32"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="{StaticResource CornerRadius10}">

                            <Path Width="16"
                                  Height="16"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Stroke="{DynamicResource WhiteBrush}"
                                  StrokeThickness="1.7"
                                  StrokeLineJoin="Round"
                                  Data="M 11,1 L 3,10 L 9,10 L 7,17 L 15,7 L 9,7 Z"/>
                        </Border>

                        <TextBlock Text="FocusLab"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource BrandTextStyle}"
                                   Foreground="{DynamicResource FlText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="NavigationList"
                             Grid.Row="2"
                             SelectedIndex="0"
                             Background="{DynamicResource TransparentBrush}"
                             BorderThickness="0"
                             Padding="0"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="NavigationList_SelectionChanged">

                        <ListBoxItem Tag="home">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;"
                                           Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Text="Головна"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="tasks">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;"
                                               Style="{StaticResource SidebarIconStyle}"/>
                                    <TextBlock Text="Завдання"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource FlSurface2}"
                                        Padding="{StaticResource CountBadgePadding}"
                                        CornerRadius="{StaticResource CornerRadius10}">
                                    <TextBlock Text="8"
                                               FontSize="{StaticResource TinyFontSize}"/>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="calendar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE787;"
                                           Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Text="Календар"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="timer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE916;"
                                           Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Text="Таймер"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;"
                                           Style="{StaticResource SidebarIconStyle}"/>
                                <TextBlock Text="Налаштування"/>
                            </StackPanel>
                        </ListBoxItem>

                    </ListBox>

                    <Button Grid.Row="3"
                            Content="Вийти з акаунта"
                            Command="{Binding LogoutCommand}"
                            Padding="{StaticResource NavigationItemPadding}"
                            HorizontalContentAlignment="Left"
                            Foreground="{DynamicResource FlMuted}"
                            Background="{DynamicResource TransparentBrush}"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Змінюється лише ця область -->
            <ContentControl x:Name="WorkspaceContent"
                            Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

        </Grid>
    </Viewbox>
</UserControl>
