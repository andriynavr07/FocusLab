<UserControl x:Class="Frontend.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Frontend.Services"
             xmlns:ctl="clr-namespace:Frontend.Controls"
             xmlns:local="clr-namespace:Frontend.Views"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1440"
             d:DesignHeight="900"
             FontFamily="{StaticResource MainFontFamily}"
             Background="{DynamicResource FlBg}"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding"
                    Value="{StaticResource NavigationItemPadding}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource FlMuted}"/>
            <Setter Property="Background"
                    Value="{DynamicResource TransparentBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontFamily"
                    Value="{StaticResource MainFontFamily}"/>
            <Setter Property="FontSize"
                    Value="{StaticResource BodyFontSize}"/>
            <Setter Property="FontWeight"
                    Value="{StaticResource MediumFontWeight}"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="{StaticResource CornerRadius8}">

                            <ContentPresenter
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource PrimaryTintBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource PrimaryBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="{StaticResource SemiBoldFontWeight}"/>
                            </Trigger>

                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{DynamicResource FlSurface2}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Іконки Windows, а не основний текстовий шрифт -->
        <Style x:Key="SidebarIconStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Viewbox Stretch="Uniform">
        <Grid Width="1440"
              Height="900"
              Background="{DynamicResource FlBg}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Постійна бічна панель -->
            <Border Grid.Column="0"
                    Background="{DynamicResource FlBg}"
                    BorderBrush="{DynamicResource FlLine}"
                    BorderThickness="0,0,1,0">

                <Grid Margin="{StaticResource SidebarPadding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="32"
                                Height="32"
                                Background="{DynamicResource PrimaryBrush}"
                                CornerRadius="{StaticResource CornerRadius10}">

                            <ctl:Icon Kind="Zap" Size="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="FocusLab"
                                   Margin="10,0,0,0"
                                   Style="{StaticResource BrandTextStyle}"
                                   Foreground="{DynamicResource FlText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <ListBox x:Name="NavigationList"
                             Grid.Row="2"
                             SelectedIndex="0"
                             Background="{DynamicResource TransparentBrush}"
                             BorderThickness="0"
                             Padding="0"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="NavigationList_SelectionChanged">

                        <ListBoxItem Tag="home">
                            <StackPanel Orientation="Horizontal">
                                <ctl:Icon Kind="Dashboard" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Translate Text=&quot;Головна&quot;}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="tasks">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <ctl:Icon Kind="Tasks" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{loc:Translate Text=&quot;Завдання&quot;}"/>
                                </StackPanel>

                                <Border Grid.Column="1"
                                        Background="{DynamicResource FlSurface2}"
                                        Padding="{StaticResource CountBadgePadding}"
                                        CornerRadius="{StaticResource CornerRadius10}">
                                    <TextBlock Text="{Binding PendingTaskCount}"
                                               FontSize="{StaticResource TinyFontSize}"/>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PendingTaskCount}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </ListBoxItem>

                        <ListBoxItem Tag="calendar">
                            <StackPanel Orientation="Horizontal">
                                <ctl:Icon Kind="Calendar" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Translate Text=&quot;Календар&quot;}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="timer">
                            <StackPanel Orientation="Horizontal">
                                <ctl:Icon Kind="Clock" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Translate Text=&quot;Таймер&quot;}"/>
                            </StackPanel>
                        </ListBoxItem>

                        <ListBoxItem Tag="settings">
                            <StackPanel Orientation="Horizontal">
                                <ctl:Icon Kind="Settings" Size="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Translate Text=&quot;Налаштування&quot;}"/>
                            </StackPanel>
                        </ListBoxItem>

                    </ListBox>

                    <Button Grid.Row="3"
                            Content="{loc:Translate Text=&quot;Вийти з акаунта&quot;}"
                            Command="{Binding LogoutCommand}"
                            Padding="{StaticResource NavigationItemPadding}"
                            HorizontalContentAlignment="Left"
                            Foreground="{DynamicResource FlMuted}"
                            Background="{DynamicResource TransparentBrush}"
                            BorderThickness="0"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- Змінюється лише ця область -->
            <ContentControl x:Name="WorkspaceContent"
                            Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>

            <!-- Форма «Нове завдання» поверх будь-якої сторінки: з дашборда користувач нікуди не переходить -->
            <local:TaskFormModal Grid.Column="1" DataContext="{Binding Tasks}"/>

        </Grid>
    </Viewbox>
</UserControl>
