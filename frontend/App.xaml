             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Typography.xaml"/>
                <ResourceDictionary Source="Resources/Spacing.xaml"/>
                <ResourceDictionary Source="Resources/Controls.xaml"/>
                <ResourceDictionary Source="Resources/Auth.xaml"/>
                <ResourceDictionary Source="Resources/Theme.Dark.xaml"/>
                <ResourceDictionary Source="Resources/Board.xaml"/>
                <ResourceDictionary Source="Resources/Pages.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>