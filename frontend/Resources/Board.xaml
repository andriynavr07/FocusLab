<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Frontend.Converters">

    <BooleanToVisibilityConverter x:Key="FlBoolToVis"/>
    <converters:ProgressToDashConverter x:Key="FlProgressToDash"/>
    <FontFamily x:Key="FlIcons">Segoe MDL2 Assets</FontFamily>

    <!-- ===== Кнопки ===== -->
    <Style x:Key="FlButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource FlText}"/>
        <Setter Property="Background" Value="{DynamicResource FlSurface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FlLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,9"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlPrimaryButton" TargetType="Button" BasedOn="{StaticResource FlButton}">
        <Setter Property="Background" Value="{DynamicResource FlAccent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FlAccent}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="FlIconButton" TargetType="Button" BasedOn="{StaticResource FlButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource FlMuted}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="FontFamily" Value="{StaticResource FlIcons}"/>
    </Style>

    <Style x:Key="FlDangerButton" TargetType="Button" BasedOn="{StaticResource FlButton}">
        <Setter Property="Background" Value="{DynamicResource FlDangerSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FlDangerSoft}"/>
        <Setter Property="Foreground" Value="{DynamicResource FlDanger}"/>
        <Setter Property="Padding" Value="9"/>
        <Setter Property="FontFamily" Value="{StaticResource FlIcons}"/>
    </Style>

    <Style x:Key="FlDashedButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource FlAccent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent">
                        <Rectangle x:Name="Dash" RadiusX="12" RadiusY="12" Stroke="{DynamicResource FlLine}"
                                   StrokeThickness="1.5" StrokeDashArray="4 4"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource FlAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlCardButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{DynamicResource FlSurface}"
                            BorderBrush="{DynamicResource FlLine}" BorderThickness="1"
                            CornerRadius="14" Padding="14">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Поля вводу ===== -->
    <Style x:Key="FlTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource FlText}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource FlText}"/>
        <Setter Property="Background" Value="{DynamicResource FlSurface2}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource FlLine}"/>
        <Setter Property="Padding" Value="14,11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost"/>
                            <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource FlMuted}"
                                       IsHitTestVisible="False" Visibility="Collapsed"
                                       VerticalAlignment="Top" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Ph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlSearchBox" TargetType="TextBox" BasedOn="{StaticResource FlTextBox}">
        <Setter Property="Padding" Value="42,10,12,10"/>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style x:Key="FlComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource FlText}"/>
        <Setter Property="Padding" Value="12,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlSurface2}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlAccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FlComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource FlText}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource FlComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid x:Name="Root" MinHeight="44">
                        <ToggleButton Focusable="False" ClickMode="Press" Cursor="Hand"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{DynamicResource FlSurface2}" BorderBrush="{DynamicResource FlLine}"
                                            BorderThickness="1" CornerRadius="10"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="14,0,38,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource FlIcons}" FontSize="11"
                                   Foreground="{DynamicResource FlMuted}" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade">
                            <Border MinWidth="{Binding ActualWidth, ElementName=Root}" MaxHeight="260" Margin="0,4,0,0" Padding="4"
                                    Background="{DynamicResource FlSurface}" BorderBrush="{DynamicResource FlLine}"
                                    BorderThickness="1" CornerRadius="10">
                                <ScrollViewer><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Кнопка-поле (для вибору дати) -->
    <Style x:Key="FlFieldToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource FlText}"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border MinHeight="44" Background="{DynamicResource FlSurface2}" BorderBrush="{DynamicResource FlLine}"
                            BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Чіп-тег для фільтра -->
    <Style x:Key="FlTagChip" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource FlAccent}"/>
        <Setter Property="Background" Value="{DynamicResource FlAccentSoft}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                            BorderThickness="1" CornerRadius="10" Padding="10,3" Margin="0,0,6,0">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="Danger">
                <Setter Property="Foreground" Value="{DynamicResource FlDanger}"/>
                <Setter Property="Background" Value="{DynamicResource FlDangerSoft}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Warn">
                <Setter Property="Foreground" Value="{DynamicResource FlWarn}"/>
                <Setter Property="Background" Value="{DynamicResource FlWarnSoft}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Success">
                <Setter Property="Foreground" Value="{DynamicResource FlSuccess}"/>
                <Setter Property="Background" Value="{DynamicResource FlSuccessSoft}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Вибір пріоритету (чіпи з макета «Нове завдання»: вибраний — з червоною обвідкою) -->
    <Style x:Key="FlPriorityItem" TargetType="ListBoxItem">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="{DynamicResource FlSurface2}" BorderBrush="{DynamicResource FlLine}"
                            BorderThickness="1" CornerRadius="8" Padding="6,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse x:Name="Dot" Width="6" Height="6" Margin="0,0,7,0" Fill="{DynamicResource FlMuted}"/>
                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FlMuted}" x:Name="Tx"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlMuted}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FlDanger}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource FlDangerSoft}"/>
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource FlDanger}"/>
                            <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource FlDanger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>