<Window x:Class="Frontend.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Frontend.ViewModels"
        xmlns:views="clr-namespace:Frontend.Views"
        mc:Ignorable="d"
        Title="FocusLab" Height="700" Width="1000"
        Background="{DynamicResource FlBg}">
    <ContentControl Content="{Binding Current}">
        <ContentControl.Resources>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}">
                <views:LoginView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
                <views:RegisterView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:WorkspaceViewModel}">
                <views:WorkspaceView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TasksViewModel}">
                <views:TasksView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
                <views:CalendarView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TimerViewModel}">
                <views:TimerView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
        </ContentControl.Resources>
    </ContentControl>
</Window>