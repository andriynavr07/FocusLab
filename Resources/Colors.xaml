<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==================== СПІЛЬНІ КОЛЬОРИ ==================== -->

    <Color x:Key="PrimaryColor">#FF2A75FF</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="TransparentColor">#00000000</Color>

    <!-- ==================== СВІТЛА ТЕМА ==================== -->

    <Color x:Key="BackgroundColor">#FFF5F6FA</Color>
    <Color x:Key="TextColor">#FF1A1B2E</Color>
    <Color x:Key="InputBackgroundColor">#FFF3F4F6</Color>
    <Color x:Key="BorderColor">#FFE5E7EB</Color>
    <Color x:Key="SecondaryTextColor">#FF6B7280</Color>
    <Color x:Key="MutedTextColor">#FF9CA3AF</Color>
    <Color x:Key="SlateTextColor">#FF64748B</Color>

    <Color x:Key="LightToggleBackgroundColor">#FFDDE0E6</Color>
    <Color x:Key="LightToggleBorderColor">#FFC0C4CC</Color>
    <Color x:Key="LightToggleTextColor">#FF1A1A2B</Color>

    <Color x:Key="LightIllustrationBackgroundColor">#FFEEF0F4</Color>

    <!-- ==================== ТЕМНА ТЕМА ==================== -->

    <Color x:Key="DarkBackgroundColor">#FF080B11</Color>
    <Color x:Key="DarkSurfaceColor">#FF0D1424</Color>
    <Color x:Key="DarkInputBackgroundColor">#FF131B2E</Color>
    <Color x:Key="DarkSecondaryTextColor">#FF94A3B8</Color>
    <Color x:Key="DarkMutedTextColor">#FF4F637D</Color>
    <Color x:Key="DarkBorderColor">#FF1F2E45</Color>

    <Color x:Key="ResourceBackgroundColor">#FF172238</Color>
    <Color x:Key="ResourceBorderColor">#FF2B4161</Color>

    <Color x:Key="DarkToggleBackgroundColor">#FF2A3A55</Color>
    <Color x:Key="DarkToggleBorderColor">#FF3A4A65</Color>

    <Color x:Key="DarkIllustrationBackgroundColor">#FF101A2D</Color>

    <!-- ==================== СТАНИ ТА АКЦЕНТИ ==================== -->

    <Color x:Key="DangerColor">#FFEF4444</Color>
    <Color x:Key="DangerMutedColor">#FFF87171</Color>
    <Color x:Key="WarningColor">#FFF59E0B</Color>
    <Color x:Key="SuccessColor">#FF10B981</Color>

    <Color x:Key="PurpleAccentColor">#FFA855F7</Color>
    <Color x:Key="FileTypePurpleColor">#FFA78BFA</Color>

    <Color x:Key="RestTimerTextColor">#FF4A4638</Color>
    <Color x:Key="RestModeTextColor">#FFA68D6A</Color>

    <!-- ==================== НАПІВПРОЗОРІ КОЛЬОРИ ==================== -->

    <Color x:Key="PrimaryTintColor">#1F2A75FF</Color>

    <Color x:Key="DangerTintColor">#1FEF4444</Color>
    <Color x:Key="DangerBorderTintColor">#33EF4444</Color>
    <Color x:Key="DangerTrackTintColor">#1AEF4444</Color>
    <Color x:Key="DangerMutedTintColor">#1FF87171</Color>

    <Color x:Key="WarningTintColor">#1FF59E0B</Color>
    <Color x:Key="SuccessTintColor">#1F10B981</Color>

    <!-- ==================== КОЛЬОРИ ТІНЕЙ ==================== -->

    <Color x:Key="Shadow0CColor">#0C000000</Color>
    <Color x:Key="Shadow10Color">#10000000</Color>
    <Color x:Key="Shadow1AColor">#1A000000</Color>
    <Color x:Key="Shadow30Color">#30000000</Color>
    <Color x:Key="Shadow40Color">#40000000</Color>
    <Color x:Key="Shadow66Color">#66000000</Color>
    <Color x:Key="Shadow80Color">#80000000</Color>

    <!-- ==================== ОФОРМЛЕННЯ ПОЛОТНА FIGMA ==================== -->
    <!-- Не є частиною інтерфейсу застосунку. -->

    <Color x:Key="FigmaCanvasColor">#FF1E1E1E</Color>
    <Color x:Key="FigmaSectionBackgroundColor">#FF444444</Color>
    <Color x:Key="FigmaSectionBorderColor">#1AFFFFFF</Color>

    <!-- ==================== СПІЛЬНІ ПЕНЗЛІ ==================== -->

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource WhiteColor}" />
    <SolidColorBrush x:Key="TransparentBrush" Color="{StaticResource TransparentColor}" />

    <!-- ==================== ПЕНЗЛІ СВІТЛОЇ ТЕМИ ==================== -->

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="SlateTextBrush" Color="{StaticResource SlateTextColor}" />

    <SolidColorBrush x:Key="LightToggleBackgroundBrush" Color="{StaticResource LightToggleBackgroundColor}" />
    <SolidColorBrush x:Key="LightToggleBorderBrush" Color="{StaticResource LightToggleBorderColor}" />
    <SolidColorBrush x:Key="LightToggleTextBrush" Color="{StaticResource LightToggleTextColor}" />

    <SolidColorBrush x:Key="LightIllustrationBackgroundBrush" Color="{StaticResource LightIllustrationBackgroundColor}" />

    <!-- ==================== ПЕНЗЛІ ТЕМНОЇ ТЕМИ ==================== -->

    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="{StaticResource DarkBackgroundColor}" />
    <SolidColorBrush x:Key="DarkSurfaceBrush" Color="{StaticResource DarkSurfaceColor}" />
    <SolidColorBrush x:Key="DarkInputBackgroundBrush" Color="{StaticResource DarkInputBackgroundColor}" />
    <SolidColorBrush x:Key="DarkSecondaryTextBrush" Color="{StaticResource DarkSecondaryTextColor}" />
    <SolidColorBrush x:Key="DarkMutedTextBrush" Color="{StaticResource DarkMutedTextColor}" />
    <SolidColorBrush x:Key="DarkBorderBrush" Color="{StaticResource DarkBorderColor}" />

    <SolidColorBrush x:Key="ResourceBackgroundBrush" Color="{StaticResource ResourceBackgroundColor}" />
    <SolidColorBrush x:Key="ResourceBorderBrush" Color="{StaticResource ResourceBorderColor}" />

    <SolidColorBrush x:Key="DarkToggleBackgroundBrush" Color="{StaticResource DarkToggleBackgroundColor}" />
    <SolidColorBrush x:Key="DarkToggleBorderBrush" Color="{StaticResource DarkToggleBorderColor}" />

    <SolidColorBrush x:Key="DarkIllustrationBackgroundBrush" Color="{StaticResource DarkIllustrationBackgroundColor}" />

    <!-- ==================== ПЕНЗЛІ СТАНІВ ==================== -->

    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerMutedBrush" Color="{StaticResource DangerMutedColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <SolidColorBrush x:Key="PurpleAccentBrush" Color="{StaticResource PurpleAccentColor}" />
    <SolidColorBrush x:Key="FileTypePurpleBrush" Color="{StaticResource FileTypePurpleColor}" />

    <SolidColorBrush x:Key="RestTimerTextBrush" Color="{StaticResource RestTimerTextColor}" />
    <SolidColorBrush x:Key="RestModeTextBrush" Color="{StaticResource RestModeTextColor}" />

    <!-- ==================== НАПІВПРОЗОРІ ПЕНЗЛІ ==================== -->

    <SolidColorBrush x:Key="PrimaryTintBrush" Color="{StaticResource PrimaryTintColor}" />

    <SolidColorBrush x:Key="DangerTintBrush" Color="{StaticResource DangerTintColor}" />
    <SolidColorBrush x:Key="DangerBorderTintBrush" Color="{StaticResource DangerBorderTintColor}" />
    <SolidColorBrush x:Key="DangerTrackTintBrush" Color="{StaticResource DangerTrackTintColor}" />
    <SolidColorBrush x:Key="DangerMutedTintBrush" Color="{StaticResource DangerMutedTintColor}" />

    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTintColor}" />
    <SolidColorBrush x:Key="SuccessTintBrush" Color="{StaticResource SuccessTintColor}" />

    <!-- ==================== ПЕНЗЛІ ТІНЕЙ ==================== -->

    <SolidColorBrush x:Key="Shadow0CBrush" Color="{StaticResource Shadow0CColor}" />
    <SolidColorBrush x:Key="Shadow10Brush" Color="{StaticResource Shadow10Color}" />
    <SolidColorBrush x:Key="Shadow1ABrush" Color="{StaticResource Shadow1AColor}" />
    <SolidColorBrush x:Key="Shadow30Brush" Color="{StaticResource Shadow30Color}" />
    <SolidColorBrush x:Key="Shadow40Brush" Color="{StaticResource Shadow40Color}" />
    <SolidColorBrush x:Key="Shadow66Brush" Color="{StaticResource Shadow66Color}" />
    <SolidColorBrush x:Key="Shadow80Brush" Color="{StaticResource Shadow80Color}" />

    <!-- ==================== ПЕНЗЛІ ПОЛОТНА FIGMA ==================== -->

    <SolidColorBrush x:Key="FigmaCanvasBrush" Color="{StaticResource FigmaCanvasColor}" />
    <SolidColorBrush x:Key="FigmaSectionBackgroundBrush" Color="{StaticResource FigmaSectionBackgroundColor}" />
    <SolidColorBrush x:Key="FigmaSectionBorderBrush" Color="{StaticResource FigmaSectionBorderColor}" />

</ResourceDictionary>
